{
  "name": "farmers-market-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:live:market-operations": "tsx scripts/test-phase14.ts",
    "start:storefront:production": "node --import tsx scripts/start-storefront.ts",
    "serve:admin:production": "node --import tsx scripts/serve-admin.ts",
    "build:production-local": "tsx scripts/build-production-local.ts",
    "test:live:production-hardening": "tsx scripts/test-production-hardening.ts",
    "test:live:platform-admin": "tsx scripts/test-platform-admin.ts",
    "test:live:vendor-storefront": "tsx scripts/test-vendor-storefront.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:live:unbound": "tsx scripts/test-live.ts --unbound",
    "dev": "concurrently -k -n storefront,admin \"npm run dev:storefront\" \"npm run dev:admin\"",
    "dev:storefront": "npm run dev --workspace @market/storefront",
    "dev:admin": "npm run dev --workspace @market/admin",
    "dev:fixtures": "tsx scripts/dev-fixtures.ts",
    "build": "npm run build --workspace @market/storefront && npm run build --workspace @market/admin",
    "check:bundles": "tsx scripts/check-bundles.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @market/storefront",
    "lint": "eslint . && tsx scripts/check-boundaries.ts && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vendor": "playwright test --config playwright.vendor.config.ts",
    "test:e2e:market": "playwright test --config playwright.phase13c.config.ts",
    "verify:backend:market:baseline": "tsx scripts/verify-backend.ts --read-only --baseline",
    "verify:backend:market": "tsx scripts/verify-backend.ts --read-only",
    "verify:contracts:market": "tsx scripts/verify-market-contracts.ts",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "graphql:schema": "tsx scripts/extract-schema.ts",
    "verify:backend": "tsx scripts/verify-backend.ts",
    "test:live:market": "tsx scripts/test-live.ts --market",
    "test:live:market-storefront": "tsx scripts/test-market-storefront.ts",
    "test:live:checkout-account": "tsx scripts/test-checkout-account.ts",
    "demo:market-operations:reset": "tsx scripts/demo-market-operations.ts reset",
    "demo:market-operations:seed": "tsx scripts/demo-market-operations.ts seed",
    "demo:market-operations:showcase": "tsx scripts/demo-market-operations.ts showcase",
    "demo:market-operations:serve": "tsx scripts/demo-market-operations.ts serve",
    "demo:market-operations:start-day": "tsx scripts/demo-market-operations.ts start-day",
    "demo:market-operations:verify": "tsx scripts/demo-market-operations.ts verify",
    "demo:market-operations:test": "tsx scripts/demo-market-operations.ts test",
    "demo:market-operations:admin": "tsx scripts/demo-market-operations.ts admin",
    "demo:market-operations:storefront": "tsx scripts/demo-market-operations.ts storefront"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.9",
    "@graphql-tools/merge": "9.2.6",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
