# Inject into the Storefront and Admin runtime processes. Match the corresponding build.
APP_ENV=production
NODE_ENV=production
DEPLOYMENT_ENV=staging
ADMIN_ORIGIN=https://admin.example.com
PLATFORM_ACCOUNT_ORIGIN=https://auth.example.com
SHOP_API_URL=https://api.example.com/shop-api
PUBLIC_ADMIN_API_URL=https://api.example.com/admin-api
FRONTEND_FIXTURE_MODE=false
TRUSTED_PROXY_CIDRS=disabled
STAGING_TESTER_ACCESS=closed
STAGING_ANONYMOUS_STOREFRONTS=disabled
# Optional Admin only. Match the built customer link if used.
# CUSTOMER_STOREFRONT_ORIGIN=https://shop.example.com
# Storefront only. Match its build and the API media prefix.
ASSET_URL_PREFIX=https://api.example.com/assets/
# Storefront only. Supply the same server-only secret as API and worker at runtime.
# PLATFORM_ACCOUNT_BRIDGE_KEY=
HOSTED_TRANSPORT=railway-private
HOST=::
# PORT is injected by Railway. Do not set SERVER_CERT_PATH, SERVER_KEY_PATH or ADMIN_PORT.
STOREFRONT_PARENT_DOMAIN=farmerlane.com
STOREFRONT_PILOT_HOSTS="vendor-pilot.example.com market-pilot.example.com"
# Inject a different key per frontend. Match only that service's corresponding gateway key.
MARKET_INGRESS_KEY=
# Storefront only. Match the API service values. Keep both out of build environments.
INTERNAL_API_ORIGIN=http://api.railway.internal:3000
MARKET_SSR_API_KEY=
