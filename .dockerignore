# Only build inputs belong in the context. In particular, exclude local env files and output.
**
!package.json
!package-lock.json
!tsconfig.json
!apps/*/package.json
!apps/*/tsconfig.json
!apps/*/index.html
!apps/*/vite.config.ts
!apps/*/astro.config.mjs
!apps/*/config.ts
!apps/*/src/**
!apps/*/public/**
!packages/*/package.json
!packages/*/src/**
!scripts/Caddyfile.hosted
!scripts/frontend-build-environment.mjs
!scripts/frontend-build-manifest.ts
!scripts/frontend-production-http.ts
!scripts/frontend-tooling.ts
!scripts/hosted-gateway.mjs
!scripts/run-hosted-gateway.sh
!scripts/serve-admin.ts
!scripts/start-storefront.ts

**/.[eE][nN][vV]*
**/.[eE][nN][vV]*/**
**/.git/**
**/node_modules/**
**/*.log
**/*.tmp

# Keep credentials, backups and browser captures out of admitted paths.
**/.[nN][pP][mM][rR][cC]
**/.netrc
**/.git-credentials
**/.ssh/**
**/.aws/**
**/.cloudflared/**
**/.railway/**
**/.certs/**
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
**/*.har
**/*.dump
**/*.dump.gz
**/*.backup
**/playwright/.auth/**

# Guard against local output inside an allowlisted source or public directory.
**/.runtime/**
**/.cache/**
**/.tmp/**
**/coverage/**
**/test-results/**
**/playwright-report/**
**/.astro/**
**/.vite/**
**/dist/**
**/*.tsbuildinfo
**/storage-state.json
**/auth-state.json
**/service-account.json
**/credentials.json
