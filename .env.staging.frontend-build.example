# Inject these settings into both the Storefront and Admin build processes.
# Dockerfile additionally requires MARKET_WEB_APP=admin or MARKET_WEB_APP=storefront.
APP_ENV=production
NODE_ENV=production
DEPLOYMENT_ENV=staging
ADMIN_ORIGIN=https://admin.example.com
PLATFORM_ACCOUNT_ORIGIN=https://auth.example.com
SHOP_API_URL=https://api.example.com/shop-api
PUBLIC_ADMIN_API_URL=https://api.example.com/admin-api
ASSET_URL_PREFIX=https://api.example.com/assets/
FRONTEND_FIXTURE_MODE=false
# Optional Admin customer link. Repeat this exact value at Admin runtime if used.
# CUSTOMER_STOREFRONT_ORIGIN=https://shop.example.com
