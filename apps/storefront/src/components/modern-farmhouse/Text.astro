---
import {
  websiteSectionStyle,
  websiteSectionAttributes,
  websiteObjectStyle,
  type WebsiteTextSection,
} from '@market/theme/storefront';
import '../../styles/website-sections.css';
const { section, editorId } = Astro.props as {
  section: WebsiteTextSection;
  editorId?: string;
};
---

<section
  {...websiteSectionAttributes(section)}
  style={websiteSectionStyle(section)}
  class="farmhouse-space farmhouse-text-section website-section"
  data-variant={section.presentation.variant ?? 'standard'}
  data-editor-section={editorId ?? `farmhouse:${section.id}`}
  data-alignment={section.presentation.alignment}
>
  <div class="website-copy">
    {section.content.heading && (
      <h2 style={websiteObjectStyle(section, 'heading')}>
        {section.content.heading}
      </h2>
    )}
    {section.content.body && (
      <p style={websiteObjectStyle(section, 'paragraph')}>
        {section.content.body}
      </p>
    )}
  </div>
</section>

<style>
  .farmhouse-text-section > div {
    max-width: 45rem;
    overflow-wrap: anywhere;
  }
  .farmhouse-text-section p {
    white-space: pre-line;
  }
  .farmhouse-text-section[data-alignment='center'] > div {
    margin-inline: auto;
    text-align: center;
  }
  .farmhouse-text-section[data-alignment='right'] > div {
    margin-inline-start: auto;
    text-align: right;
  }
</style>
