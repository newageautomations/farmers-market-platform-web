---
import { VendorPreorderBanner } from './VendorPreorderBanner';
import type { ComponentProps } from 'react';
import '../styles/preorder-banner.css';
import { themePageStructure } from '@market/theme/storefront';
type Props = ComponentProps<typeof VendorPreorderBanner>;
// Market-standard websites show the market's own details without the general guidance.
const storefront = Astro.locals.storefront;
const concise = themePageStructure(
  storefront?.appearance?.theme,
  storefront?.kind,
).conciseCommerce;
---

<VendorPreorderBanner {...Astro.props} concise={concise} client:load />
