---
/**
 * Pasture's illustration set: flat, rounded field-and-garden artwork drawn
 * for this theme. Every drawing shares one 96 x 96 frame, so it can stand
 * alone or be placed inside a larger scene with `x`, `y` and `size`.
 * Decorative only.
 */
import type { PastureArtName } from './art';
interface Props {
  name: PastureArtName;
  x?: number;
  y?: number;
  size?: number;
  class?: string;
}
const { name, x, y, size, class: className } = Astro.props;
/* A leaf pointing along +x from its base at the origin. */
const leafShape = (length: number) =>
  `M0 0C${length * 0.3} ${-length * 0.36} ${length * 0.72} ${-length * 0.34} ${length} 0C${length * 0.72} ${length * 0.3} ${length * 0.3} ${length * 0.3} 0 0z`;
/* A leaf whose tip curls up, away from the +x axis. */
const curledLeaf = (length: number) =>
  `M0 0C${length * 0.22} ${-length * 0.46} ${length * 0.68} ${-length * 0.52} ${length} ${-length * 0.2}C${length * 0.72} ${length * 0.14} ${length * 0.3} ${length * 0.22} 0 0z`;
/* The sprig's stem is one arching curve. Each leaf sits on the curve and
   points away from it, alternating sides and shrinking toward the tip. */
const stem = [
  [10, 92],
  [12, 54],
  [40, 18],
  [88, 12],
] as const;
const sprigStem = `M${stem[0].join(' ')}C${stem[1].join(' ')} ${stem[2].join(' ')} ${stem[3].join(' ')}`;
const pointOnStem = (t: number) => {
  const u = 1 - t;
  const weights = [u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t];
  const slopes = [
    -3 * u * u,
    3 * u * u - 6 * u * t,
    6 * u * t - 3 * t * t,
    3 * t * t,
  ];
  const sum = (values: readonly number[], axis: 0 | 1) =>
    values.reduce(
      (total, value, index) => total + value * stem[index]![axis],
      0,
    );
  return {
    x: sum(weights, 0),
    y: sum(weights, 1),
    angle: (Math.atan2(sum(slopes, 1), sum(slopes, 0)) * 180) / Math.PI,
  };
};
const sprigLeaves = [0.16, 0.28, 0.4, 0.52, 0.64, 0.76, 0.88]
  .map((t, index) => {
    const point = pointOnStem(t);
    const side = index % 2 === 0 ? -1 : 1;
    return {
      x: point.x,
      y: point.y,
      angle: point.angle + side * 52,
      length: 24 - index * 1.8,
      light: index % 2 === 0,
    };
  })
  .concat({ ...pointOnStem(1), length: 15, light: false });
---

<svg
  class:list={['pw-art', `pw-art-${name}`, className]}
  viewBox="0 0 96 96"
  x={x}
  y={y}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
