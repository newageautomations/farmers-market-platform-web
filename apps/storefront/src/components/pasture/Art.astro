  {name === 'sprig' && (
    <>
      <path
        d={sprigStem}
        stroke="#2F7D3A"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
      {sprigLeaves.map((leaf) => (
        <path
          d={leafShape(leaf.length)}
          transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.angle})`}
