---
import { dashboardClasses, buttonClassName } from '@market/ui/presentation';
---

<details class={dashboardClasses.menu} open>
  <summary
    class={buttonClassName({ variant: 'secondary', iconOnly: true })}
    aria-label="Dashboard menu"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M4 6h16M4 12h16M4 18h16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
  </summary>
  <div class={dashboardClasses.menuContent}>
    <div class={dashboardClasses.mobileNavigation}>
      <slot name="navigation" />
    </div>
    <div class="actions">
      <slot />
    </div>
  </div>
</details>
<script>
  import { installDashboardMenu } from '@market/ui/presentation';
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    '.ui-dashboard-menu',
  ))
    installDashboardMenu(menu);
</script>
