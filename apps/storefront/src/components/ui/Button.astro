---
import type { HTMLAttributes } from 'astro/types';
import {
  buttonClassName,
  type ButtonVariant,
  type ButtonSize,
} from '@market/ui/presentation';
// Native SSR preserves form submitters without hydrating React for appearance.
interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  iconOnly?: boolean;
  loading?: boolean;
}
const {
  variant,
  size,
  iconOnly,
  loading = false,
  href,
  disabled,
  class: className = '',
  type = 'button',
  ...props
} = Astro.props;
if (href && !/^\/(?!\/)|^#/.test(href))
  throw new Error('Expected a local storefront link');
const Tag = href ? 'a' : 'button';
---

<Tag
  {...props}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || loading}
  aria-busy={loading ? 'true' : props['aria-busy']}
  class={buttonClassName({
    variant,
    size,
    iconOnly,
    className: String(className),
  })}
>
  <slot />
</Tag>
