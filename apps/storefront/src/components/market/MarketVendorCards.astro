---
import type { MarketOccurrenceVendor } from '@market/api';
import { safeAsset } from '@market/storefront-core';
import { cardClassName } from '@market/ui/presentation';
import { vendorInitial } from '../../lib/market-website';
import '../../styles/market-website.css';
/** Each card opens its vendor's offerings for the displayed market date. */
const {
  vendors,
  occurrenceId,
  detailed = false,
  cardTheme = 'standard',
  marketDay = false,
  booths,
  boothPage,
} = Astro.props as {
  vendors: readonly MarketOccurrenceVendor[];
  occurrenceId: string;
  detailed?: boolean;
  cardTheme?: 'standard' | 'inverse' | 'soft';
  marketDay?: boolean;
  /**
   * Market Day on themes with booth cards: each vendor's booth on the map.
   * The card then shows the vendor's category and leads to their booth
   * instead of their shop offerings.
   */
  booths?: Record<
    string,
    { elementId: string; label: string; category: string }
  >;
  /**
   * Booth links on another page (the vendors page) lead to this Market Day
   * homepage, e.g. `/?marketDay=12`, which opens the booth on its map.
   */
  boothPage?: string;
};
const boothHref = (elementId: string) =>
  boothPage
    ? `${boothPage}&booth=${encodeURIComponent(elementId)}#market-day-map`
    : '#market-day-map';
const offeringsHref = (vendor: MarketOccurrenceVendor) =>
  `/shop?occurrence=${encodeURIComponent(occurrenceId)}&vendor=${encodeURIComponent(vendor.vendorId)}`;
---

<ul
  data-card-theme={cardTheme}
  class:list={['harvest-vendors', 'market-vendor-cards']}
>
  {vendors.map((vendor) => {
    const image = safeAsset(vendor.image ?? undefined);
    const booth = booths?.[vendor.vendorId];
    return (
      <li
        class={cardClassName({
          spacing: 'contained',
          className: 'market-vendor-card',
        })}
      >
        {image ? (
          <img
            class="market-vendor-image"
            src={image}
            alt=""
            width="120"
            height="120"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="harvest-vendor-symbol" aria-hidden="true">
            {vendorInitial(vendor.name)}
          </span>
        )}
        <h3>
          {booths ? (
            booth ? (
              <a
                class="market-vendor-offerings"
                href={boothHref(booth.elementId)}
                data-market-day-booth={booth.elementId}
              >
                <span class="farmstand-text-link">{vendor.name}</span>
              </a>
            ) : (
              vendor.name
            )
          ) : (
            <a class="market-vendor-offerings" href={offeringsHref(vendor)}>
              <span class="farmstand-text-link">{vendor.name}</span>
            </a>
          )}
        </h3>
        {marketDay && (
          <p hidden data-market-day-follow={vendor.vendorId}>
            Following
          </p>
        )}
        {booths ? (
          booth?.category && <p class="market-vendor-meta">{booth.category}</p>
        ) : (
          <p class="market-vendor-meta">
            {vendor.offeringCount > 0
              ? `${vendor.offeringCount} ${vendor.offeringCount === 1 ? 'offering' : 'offerings'} this market day`
              : 'Visit their booth on market day'}
          </p>
        )}
        <div class="market-vendor-actions">
          {booths ? (
            booth ? (
              <span class="harvest-text-link" aria-hidden="true">
                Find their booth ({booth.label}){' '}
                <span aria-hidden="true">&#8594;</span>
              </span>
            ) : (
              <span class="market-vendor-meta">Not on today's map</span>
            )
          ) : (
            <span class="harvest-text-link" aria-hidden="true">
              Shop offerings <span aria-hidden="true">&#8599;</span>
            </span>
          )}
          {detailed && vendor.storefrontUrl && (
            <a class="harvest-text-link" href={vendor.storefrontUrl}>
              Visit storefront <span aria-hidden="true">&#8599;</span>
            </a>
          )}
        </div>
      </li>
    );
  })}
</ul>
