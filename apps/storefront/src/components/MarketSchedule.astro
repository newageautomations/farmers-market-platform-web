---
import type { VendorMarketAppearance } from '@market/api';
import { buttonClassName, disclosureClassName } from '@market/ui/presentation';
import { AppearancePreorder } from './AppearancePreorder';
import Button from './ui/Button.astro';
import '../styles/find-us.css';

const {
  rows,
  storefrontId,
  preview = false,
  heading = 'Upcoming Markets',
  class: className,
  paging,
} = Astro.props as {
  rows: readonly VendorMarketAppearance[];
  storefrontId: string;
  preview?: boolean;
  heading?: string;
  class?: string;
  /**
   * Show the first `initial` rows and add `more` per "Show more markets"
   * press. Every row is rendered, so visitors without scripts see them all.
   */
  paging?: { initial: number; more: number } | null;
};
const paged = !!paging && rows.length > paging.initial;

const format = (
  row: VendorMarketAppearance,
  options: Intl.DateTimeFormatOptions,
) =>
  new Intl.DateTimeFormat('en-US', {
    ...options,
    timeZone: row.timezone,
  }).format(new Date(row.startsAt));

const hours = (row: VendorMarketAppearance) =>
  `${format(row, { hour: 'numeric', minute: '2-digit' })} to ${new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: row.timezone }).format(new Date(row.endsAt))}`;

// The authoritative venue is the saved address field. Avoid sending bare venue names or fixture placeholders to Maps.

const directions = (row: VendorMarketAppearance) =>
  /\d+\s+\S+/.test(row.venue) && !/fixture|test location/i.test(row.venue)
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(row.venue)}`
    : undefined;

const groups = new Map<string, VendorMarketAppearance[]>();

for (const row of rows) {
  const month = format(row, { month: 'long', year: 'numeric' });
  groups.set(month, [...(groups.get(month) ?? []), row]);
}
---

<section
  class:list={['find-schedule', className]}
  data-find-schedule={paged ? '' : undefined}
  data-initial={paged ? paging!.initial : undefined}
  data-more={paged ? paging!.more : undefined}
>
  <h2>{heading}</h2>
  {[...groups].map(([month, appearances]) => (
    <div class="find-month" data-find-month>
      <h3>{month}</h3>
      <div class="find-month-entries">
        {appearances.map((row) => (
          <details
            class={disclosureClassName('find-row')}
            data-disclosure-icon="plus"
            data-find-row
          >
            <summary>
              <time class="find-date" datetime={row.startsAt}>
                <span>{format(row, { month: 'short' })}</span>
                <strong>{format(row, { day: 'numeric' })}</strong>
              </time>
              <span>
                <strong>{row.marketName}</strong>
                <span>
                  {format(row, { weekday: 'long' })} · {hours(row)}
                </span>
                <span>{row.venue}</span>
              </span>
            </summary>
            <div class="ui-disclosure-content find-row-detail">
              <p>Attendance confirmed.</p>
              {row.pickupInstructions && <p>{row.pickupInstructions}</p>}
              <div class="find-actions">
                {directions(row) && (
                  <a
                    class={buttonClassName({
                      variant: 'secondary',
                    })}
                    href={directions(row)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Get Directions
                  </a>
                )}
                {row.marketWebsite && (
                  <a
                    class={buttonClassName({
                      variant: 'secondary',
                    })}
                    href={row.marketWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Visit Market Website
                  </a>
                )}
                {row.preorderAvailable && (
                  <AppearancePreorder
                    storefrontId={storefrontId}
                    occurrenceId={row.id}
                    preview={preview}
                    client:load
                  />
                )}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  ))}
  {paged && (
    <div class="find-schedule-more" data-find-more hidden>
      <Button variant="secondary" data-find-more-button>
        Show more markets
      </Button>
    </div>
  )}
</section>

<script>
  // Progressive enhancement: rows past the first page are hidden only once
  // this runs, and each press reveals the next batch.
  for (const schedule of document.querySelectorAll<HTMLElement>(
    '[data-find-schedule]',
  )) {
    const rows = [...schedule.querySelectorAll<HTMLElement>('[data-find-row]')];
    const months = [
      ...schedule.querySelectorAll<HTMLElement>('[data-find-month]'),
    ];
    const more = schedule.querySelector<HTMLElement>('[data-find-more]');
    const button = more?.querySelector<HTMLButtonElement>(
      '[data-find-more-button]',
    );
    const initial = Number(schedule.dataset.initial);
    const step = Number(schedule.dataset.more);
    if (!more || !button || !(initial > 0) || !(step > 0)) continue;
    let shown = initial;
    const render = () => {
      rows.forEach((row, index) => (row.hidden = index >= shown));
      // A month whose markets are all still hidden hides its heading too.
      for (const month of months)
        month.hidden = ![
          ...month.querySelectorAll<HTMLElement>('[data-find-row]'),
        ].some((row) => !row.hidden);
      more.hidden = shown >= rows.length;
    };
    render();
    button.addEventListener('click', () => {
      const first = rows[shown];
      shown += step;
      render();
      // Keep keyboard and screen reader users at the first new market.
      first?.querySelector('summary')?.focus();
    });
  }
</script>
