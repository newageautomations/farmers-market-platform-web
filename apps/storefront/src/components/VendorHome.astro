---
import type { StorefrontContext } from '@market/storefront-core';
import { safeAsset } from '@market/storefront-core';
import type { PublicCatalog, AppError } from '@market/api';
import { ErrorState, SectionHeader } from '@market/ui';
import ProductCards from './ProductCards.astro';
import HarvestHero from './home/HarvestHero.astro';
import EmptyState from './ui/EmptyState.astro';
import Button from './ui/Button.astro';
import { storefrontText } from '@market/theme/storefront';
interface Props {
  context: StorefrontContext;
  catalog?: PublicCatalog;
  error?: AppError;
}
const { context, catalog, error } = Astro.props;
const vendor = context.appearance?.vendor;
const aboutSection = vendor
  ? {
      ...vendor,
      aboutBlurb: vendor.aboutUseLegacyStory
        ? (context.appearance?.homepage.story ?? '')
        : vendor.aboutBlurb,
    }
  : {
      aboutEnabled: !!context.appearance?.homepage.story,
      aboutBlurb: context.appearance?.homepage.story ?? '',
      aboutImage: '',
      aboutShape: 'rounded',
      aboutAlt: '',
    };
const image = catalog?.items
  .map((item) => safeAsset(item.featuredAsset?.preview))
  .find(Boolean);
---

<div data-composition="vendor" data-template={context.template}>
  <HarvestHero
    context={context}
    image={image}
    href="/products"
    action="Shop the collection"
  />
  <section
    id="catalog"
    data-editor-section="featured"
    class="harvest-section"
    aria-label="Featured collection"
  >
    <SectionHeader
      title={storefrontText(context.appearance, 'featuredHeading')}
      variant="consumer"
    >
      <a href="/products">
        <span data-storefront-text="featuredLinkLabel">
          {storefrontText(context.appearance, 'featuredLinkLabel')}
        </span>{' '}
        ↗
      </a>
    </SectionHeader>
    {error ? (
      <ErrorState error={error} />
    ) : catalog?.items.length ? (
      <ProductCards
        items={catalog.items}
        featured
        storefrontId={
          context.source === 'backend' ? context.storefrontId : undefined
        }
      />
    ) : (
      <EmptyState title="Good things are on their way" level={3}>
        <p>
          Our collection will appear here when products are available. Come back
          soon.
        </p>
      </EmptyState>
    )}
  </section>
  {aboutSection.aboutEnabled && aboutSection.aboutBlurb && (
    <section
      data-editor-section="about"
      class:list={[
        'vendor-about',
        !aboutSection.aboutImage && 'vendor-about-text',
      ]}
    >
      <div>
        <h2 data-storefront-text="aboutHeading">
          {storefrontText(context.appearance, 'aboutHeading', context.name)}
        </h2>
        <p data-about-blurb>{aboutSection.aboutBlurb}</p>
        {context.appearance?.about.enabled && (
          <Button href="/about" variant="secondary">
            <span data-storefront-text="aboutLinkLabel">
              {storefrontText(context.appearance, 'aboutLinkLabel')}
            </span>{' '}
            ↗
          </Button>
        )}
      </div>
      {safeAsset(aboutSection.aboutImage) && (
        <img
          class="product-media"
          data-hero-shape={aboutSection.aboutShape ?? 'rounded'}
          src={safeAsset(aboutSection.aboutImage)}
          alt={aboutSection.aboutAlt || context.name}
          width="800"
          height="700"
          loading="lazy"
        />
      )}
    </section>
  )}
  <section
    class="harvest-invitation vendor-closing"
    data-editor-section="closing"
    aria-label="Explore the collection"
  >
    <h2 data-storefront-text="closingHeading" style="white-space:pre-line">
      {storefrontText(context.appearance, 'closingHeading')}
    </h2>
    <p data-storefront-text="closingText">
      {storefrontText(context.appearance, 'closingText')}
    </p>
    <Button href="/products">
      <span data-storefront-text="closingLabel">
        {storefrontText(context.appearance, 'closingLabel')}
      </span>{' '}
      <span aria-hidden="true">↗</span>
    </Button>
  </section>
</div>
