---
import { vendorCategoryNavigation } from '../../lib/storefront-taxonomy';
import type { PublicCatalog } from '@market/api';
import type { StorefrontContext } from '@market/storefront-core';
import {
  editorialHomepageComposition,
  websiteSectionRegistry,
  isEditorialMarket,
} from '@market/theme/storefront';
import { websiteSectionRenderers } from './section-renderers';
import Hero from './Hero.astro';

interface Props {
  context: StorefrontContext;
  catalog?: PublicCatalog;
  error?: unknown;
}
const { context, catalog } = Astro.props;
if (!isEditorialMarket(context.appearance))
  throw new Error(
    'Editorial Market homepage requires its theme configuration.',
  );
const settings = context.appearance.template.settings;
const categories = (await vendorCategoryNavigation(Astro)).slice(
  0,
  settings.categories.limit,
);
// The vendor homepage does not draw the community impact artwork (the
// market homepage still does). Its slot stays in the saved order so saved
// compositions remain valid.
const composition = editorialHomepageComposition(settings, {
  productIds: (catalog?.items ?? []).map((product) => product.id),
  categoryIds: categories.map((category) => category.id),
});
---

<div
  class="em-home"
  data-template="editorial-market"
  data-spacing={settings.homepageDesign?.spacing}
  data-typography-scale={settings.homepageDesign?.typographyScale}
  data-leading-section={composition[0]?.id}
>
  {composition.map((section) => {
    if ('type' in section) {
      if (!section.visible) return null;
      const Renderer =
        websiteSectionRenderers[
          websiteSectionRegistry[section.type].renderers['editorial-market']
        ];
      return <Renderer section={section} context={context} />;
    }
    return section.id === 'hero' ? (
      <Hero
        settings={settings}
        action={{ href: '/products', label: settings.hero.buttonLabel }}
      />
    ) : null;
  })}
</div>
