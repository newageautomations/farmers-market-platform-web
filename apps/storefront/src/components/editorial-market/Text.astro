---
import {
  websiteSectionStyle,
  websiteSectionAttributes,
  websiteObjectStyle,
  type WebsiteTextSection,
} from '@market/theme/storefront';
import '../../styles/website-sections.css';
const { section, editorId } = Astro.props as {
  section: WebsiteTextSection;
  editorId?: string;
};
---

<section
  {...websiteSectionAttributes(section)}
  style={websiteSectionStyle(section)}
  class="em-section em-repeatable em-text-story website-section"
  data-editor-section={editorId ?? `editorial:${section.id}`}
  data-variant={section.presentation.variant ?? 'standard'}
  data-alignment={section.presentation.alignment}
>
  <div class="em-text-rule" aria-hidden="true"></div>
  <div class="em-text-columns website-copy">
    {section.content.heading && (
      <h2 style={websiteObjectStyle(section, 'heading')}>
        {section.content.heading}
      </h2>
    )}
    {section.content.body && (
      <div class="em-story-body">
        <p style={websiteObjectStyle(section, 'paragraph')}>
          {section.content.body}
        </p>
      </div>
    )}
  </div>
</section>
