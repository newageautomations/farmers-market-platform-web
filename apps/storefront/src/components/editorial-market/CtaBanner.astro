---
import {
  websiteSectionStyle,
  websiteSectionAttributes,
  websiteObjectStyle,
  type WebsiteCtaBannerSection,
} from '@market/theme/storefront';
import '../../styles/website-sections.css';
import type { StorefrontContext } from '@market/storefront-core';
import { websiteSectionDestination } from '../website-section-navigation';
import Button from '../ui/Button.astro';
const { section, context, editorId } = Astro.props as {
  section: WebsiteCtaBannerSection;
  context: StorefrontContext;
  editorId?: string;
};
const { content, presentation } = section;
---

<section
  {...websiteSectionAttributes(section)}
  style={websiteSectionStyle(section)}
  class="em-section em-repeatable em-callout website-section"
  data-editor-section={editorId ?? `editorial:${section.id}`}
  data-variant={presentation.variant ?? 'standard'}
  data-alignment={presentation.alignment}
  data-background={presentation.background}
>
  <div class="em-callout-layout website-layout">
    <div class="em-callout-copy website-copy">
      {content.heading && (
        <h2 style={websiteObjectStyle(section, 'heading')}>
          {content.heading}
        </h2>
      )}
      {content.body && (
        <p style={websiteObjectStyle(section, 'paragraph')}>{content.body}</p>
      )}
    </div>
    {websiteSectionDestination(context, content.destination) && (
      <div class="em-callout-action">
        <Button
          style={websiteObjectStyle(section, 'button')}
          href={content.destination}
          variant="primary"
        >
          {content.label}
          <span aria-hidden="true">→</span>
        </Button>
      </div>
    )}
  </div>
</section>
