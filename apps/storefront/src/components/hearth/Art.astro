  )}
  {name === 'stamp' && (
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <circle cx="48" cy="48" r="44" stroke-width="3" />
      <circle
        cx="48"
        cy="48"
        r="37"
        stroke-width="1.5"
        stroke-dasharray="1 5"
      />
      <path d="M48 76V40" stroke-width="3" />
      <g fill="currentColor" stroke="none">
        <ellipse cx="48" cy="28" rx="4" ry="8" />
