  )}
  {name === 'cookie' && (
    <>
      <circle cx="48" cy="50" r="34" fill="#C98A3C" />
      <path
        d="M22 40a30 30 0 0 1 18-18"
        stroke="#E0B06A"
        stroke-width="5"
        stroke-linecap="round"
        fill="none"
      />
      <g fill="#4A2C17">
        <circle cx="38" cy="42" r="5" />
        <circle cx="60" cy="36" r="4.5" />
        <circle cx="66" cy="58" r="5.5" />
        <circle cx="44" cy="64" r="4.5" />
        <circle cx="28" cy="58" r="3.5" />
        <circle cx="52" cy="50" r="3" />
