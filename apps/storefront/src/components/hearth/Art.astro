        d="M21 58c9 4 41 4 50 0"
        stroke="#D9A253"
        stroke-width="4"
        fill="none"
      />
      <ellipse cx="46" cy="36" rx="26" ry="6" fill="#9A6638" />
      <ellipse cx="46" cy="36.5" rx="21" ry="4" fill="#3D2616" />
    </>
  )}
  {name === 'wheat' && (
    <>
      <path
        d="M48 92V30"
        stroke="#B9742B"
        stroke-width="3.5"
        stroke-linecap="round"
      />
      <ellipse cx="48" cy="16" rx="5.5" ry="11" fill="#D9A253" />
      {grains.map((cy, index) => (
        <>
          <ellipse
            cx="38"
            cy={cy}
            rx="5.5"
            ry="10.5"
            transform={`rotate(-30 38 ${cy})`}
            fill={index % 2 ? '#D9A253' : '#C98A3C'}
          />
          <ellipse
            cx="58"
            cy={cy}
            rx="5.5"
            ry="10.5"
            transform={`rotate(30 58 ${cy})`}
            fill={index % 2 ? '#C98A3C' : '#D9A253'}
          />
        </>
      ))}
      <path d="M48 82c-9-1-15-8-16-16 8 1 14 7 16 16z" fill="#B9742B" />
    </>
  )}
  {name === 'pie' && (
    <>
      <path
        d="M12 54h72l-7 24a6 6 0 0 1-6 4H25a6 6 0 0 1-6-4z"
