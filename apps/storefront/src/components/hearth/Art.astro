        d="M28 32h40c4 4 6 8 6 14v30a8 8 0 0 1-8 8H30a8 8 0 0 1-8-8V46c0-6 2-10 6-14z"
        fill="#B23A48"
      />
      <path d="M22 58h52v18a8 8 0 0 1-8 8H30a8 8 0 0 1-8-8z" fill="#8C2733" />
      <rect x="32" y="48" width="32" height="24" rx="3" fill="#FCF7EC" />
      <circle cx="44" cy="61" r="5" fill="#9B2F3A" />
      <circle cx="53" cy="59" r="4" fill="#B23A48" />
      <path
        d="M67 40q3 4 3 10"
        stroke="#E9A1AA"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
    </>
  )}
  {name === 'coffee' && (
    <>
      <g class="hw-art-steam">
        <path
          d="M38 26c-5-6 5-9 0-17M53 26c-5-6 5-9 0-17"
          stroke="#B8A58C"
