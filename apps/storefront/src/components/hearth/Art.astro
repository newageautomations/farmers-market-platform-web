  )}
  {name === 'basket' && (
    <>
      <rect
        x="30"
        y="6"
        width="14"
        height="54"
        rx="7"
        transform="rotate(-18 37 33)"
        fill="#D29A4C"
      />
      <rect
        x="52"
        y="4"
        width="14"
        height="56"
        rx="7"
        transform="rotate(14 59 32)"
        fill="#C98A3C"
      />
      <path
        d="M28 22l8 3M31 32l8 3M62 18l-8 3M64 29l-8 3"
        stroke="#F6E6BF"
        stroke-width="3"
        stroke-linecap="round"
      />
      <circle cx="47" cy="42" r="14" fill="#B9742B" />
      <path
        d="M13 50h70l-7 33a7 7 0 0 1-7 5H27a7 7 0 0 1-7-5z"
        fill="#A9743A"
      />
      <path
        d="M32 60v24M48 60v26M64 60v24M18 70h60"
        stroke="#8A5A2B"
        stroke-width="3"
        stroke-linecap="round"
      />
      <path d="M10 46h76v8a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4z" fill="#8A5A2B" />
    </>
  )}
  {name === 'cheese' && (
    <>
      <path d="M12 60 60 28c12 3 21 14 24 32z" fill="#EBCB7A" />
      <path d="M12 60h72v18a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4z" fill="#D9A253" />
      <circle cx="34" cy="71" r="5" fill="#B9742B" />
      <circle cx="58" cy="68" r="4" fill="#B9742B" />
      <circle cx="72" cy="74" r="3" fill="#B9742B" />
      <circle cx="56" cy="47" r="5" fill="#D9A253" />
    </>
  )}
  {name === 'crate' && (
    <>
      <circle cx="31" cy="38" r="14" fill="#9B2F3A" />
      <circle cx="55" cy="33" r="15" fill="#C9742B" />
      <circle cx="72" cy="42" r="11" fill="#6C7A45" />
      <path d="M55 19c-1-6 3-10 8-11 0 6-3 10-8 11z" fill="#6C7A45" />
      <path d="M31 25c-1-5 2-9 7-10 0 5-2 9-7 10z" fill="#6C7A45" />
      <rect x="10" y="46" width="76" height="42" rx="4" fill="#C39A5E" />
      <path d="M10 60h76M10 74h76" stroke="#8A5A2B" stroke-width="3" />
      <rect x="16" y="46" width="9" height="42" fill="#8A5A2B" />
      <rect x="71" y="46" width="9" height="42" fill="#8A5A2B" />
    </>
  )}
  {name === 'pin' && (
    <g transform="rotate(-28 48 48)">
      <rect x="2" y="43" width="92" height="10" rx="5" fill="#8A5A2B" />
      <rect x="20" y="35" width="56" height="26" rx="9" fill="#D9A253" />
      <path
        d="M28 41h40"
        stroke="#EBCB7A"
        stroke-width="4"
        stroke-linecap="round"
      />
