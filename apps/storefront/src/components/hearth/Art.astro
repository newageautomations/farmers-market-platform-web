---
/**
 * Hearth's illustration set: flat bakehouse artwork drawn for this theme.
 * Every drawing shares one 96 x 96 frame, so it can stand alone or be placed
 * inside a larger scene with `x`, `y` and `size`. Decorative only.
 */
import type { HearthArtName } from './art';
interface Props {
  name: HearthArtName;
  x?: number;
  y?: number;
  size?: number;
  class?: string;
}
const { name, x, y, size, class: className } = Astro.props;
const grains = [30, 44, 58];
---

<svg
  class:list={['hw-art', `hw-art-${name}`, className]}
  viewBox="0 0 96 96"
  x={x}
  y={y}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {name === 'loaf' && (
    <>
      <ellipse cx="48" cy="60" rx="38" ry="24" fill="#B9742B" />
      <path
        d="M12 58c2-20 18-32 36-32s34 12 36 32c-8 8-22 12-36 12s-28-4-36-12z"
        fill="#D29A4C"
      />
      <path
        d="M32 44q6 8 4 20M48 40q5 9 2 24M64 44q2 8-2 20"
        stroke="#F6E6BF"
        stroke-width="4"
        stroke-linecap="round"
        fill="none"
      />
      <g fill="#FBF3E0">
        <circle cx="24" cy="50" r="1.6" />
        <circle cx="74" cy="52" r="1.6" />
        <circle cx="56" cy="32" r="1.4" />
        <circle cx="40" cy="34" r="1.4" />
      </g>
    </>
  )}
  {name === 'sourdough' && (
    <>
      {/* A boule with a flat base (y = 80), so it can rest on a shelf. */}
      <path
        d="M8 76c0-26 18-46 40-46s40 20 40 46a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4z"
        fill="#B9742B"
      />
      <path
        d="M13 68c1-20 17-34 35-34s34 14 35 34c-8 6-22 9-35 9s-27-3-35-9z"
        fill="#D29A4C"
      />
      <path
        d="M32 48q6 8 4 20M48 42q5 9 2 26M64 48q2 8-2 20"
        stroke="#F6E6BF"
        stroke-width="4"
        stroke-linecap="round"
        fill="none"
      />
      <g fill="#FBF3E0">
        <circle cx="24" cy="58" r="1.6" />
        <circle cx="74" cy="60" r="1.6" />
        <circle cx="56" cy="38" r="1.4" />
        <circle cx="40" cy="40" r="1.4" />
      </g>
    </>
  )}
  {name === 'croissant' && (
    <>
      <path
        d="M10 62c4-22 20-36 38-36s34 14 38 36c-6 4-12 4-16-2-4-8-12-12-22-12s-18 4-22 12c-4 6-10 6-16 2z"
        fill="#D29A4C"
      />
      <path
        d="M10 62c1-6 3-12 7-17l9 15c-4 6-10 6-16 2zM86 62c-1-6-3-12-7-17l-9 15c4 6 10 6 16 2z"
        fill="#B9742B"
      />
      <path
        d="M31 33l-5 21M42 27l-2 19M54 27l2 19M65 33l5 21"
        stroke="#A9661F"
        stroke-width="3.5"
        stroke-linecap="round"
      />
    </>
  )}
  {name === 'jam' && (
    <>
      <rect x="26" y="12" width="44" height="15" rx="3" fill="#9B2F3A" />
      <path
        d="M37 12v15M48 12v15M59 12v15M26 19.5h44"
        stroke="#F6E6BF"
        stroke-width="3"
        opacity=".75"
      />
      <path
        d="M27 30h42"
