---
import { customerNavigation } from '../lib/customer-dashboard';
import { navigationIconPaths } from '@market/ui/presentation';
const { path } = Astro.props as { path: string };
---

<nav aria-label="Customer navigation">
  {customerNavigation.map((item) => (
    <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
      <svg
        class="navigation-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d={
            navigationIconPaths[
              (item.href.split('/')[2] ??
                'overview') as keyof typeof navigationIconPaths
            ]
          }
        />
      </svg>
      <span>{item.label}</span>
    </a>
  ))}
</nav>
