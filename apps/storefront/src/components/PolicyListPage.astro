---
/**
 * The Harvest-family list page shared by Policies and a market's Terms &
 * Conditions: an editable heading and introduction, then titled sections.
 * Extracted unchanged from pages/policies.astro so both pages render the same
 * markup and editor identities (policies-intro, policies-list, policy:<id>).
 */
import ClosingInvitation from './ClosingInvitation.astro';
import {
  policyContentParts,
  publishedPolicyEntries,
  type PoliciesConfig,
} from '@market/theme/storefront';
import '../styles/about-story.css';
import '../styles/policies.css';
interface Props {
  config: PoliciesConfig;
  /** The page shows its own heading instead of a section hero. */
  sectionHero: boolean;
  /** Show the closing invitation (Policies only, and only when Contact is on). */
  closing: boolean;
  emptyMessage: string;
}
const { config, sectionHero, closing, emptyMessage } = Astro.props;
const { storefront, editorPreview } = Astro.locals;
const appearance = storefront?.appearance;
const available = (path: string) =>
  path === '/about'
    ? !!appearance?.about.enabled
    : path === '/find-us'
      ? !!appearance?.findUs?.enabled
      : path === '/contact'
        ? !!appearance?.contact?.enabled
        : path === '/faq'
          ? !!appearance?.faq?.enabled
          : path === '/policies'
            ? !!appearance?.policies?.enabled
            : true;
const entries = publishedPolicyEntries(config);
const publishedAt = storefront?.appearancePublishedAt;
const date =
  publishedAt && Number.isFinite(Date.parse(publishedAt))
    ? new Date(publishedAt)
    : undefined;
---

<article class="story-page policies-page" aria-label={config.title}>
  <section data-editor-section="policies-intro">
    {sectionHero && <h1 class="sr-only">{config.title}</h1>}
    {!sectionHero && (
      <>
        {' '}
        <h1>{config.heading}</h1>
        {config.description && (
          <p class="policies-description">{config.description}</p>
        )}
      </>
    )}
    {date && (
      <p>
        Last updated:{' '}
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
    )}
    {editorPreview && (
      <p>
        The date reflects the published storefront revision. Unsaved and draft
        edits are not published.
      </p>
    )}
  </section>
  <div data-editor-section="policies-list" class="policies-list">
    {entries.map((policy) => (
      <section
        class="policy-section"
        data-editor-section={`policy:${policy.id}`}
        aria-labelledby={`policy-${policy.id}`}
      >
        <h2 id={`policy-${policy.id}`}>{policy.title}</h2>
        <p class="policy-content">
          {policyContentParts(policy.content).map((part) =>
            part.href && available(part.href) ? (
              <a href={part.href}>{part.text}</a>
            ) : (
              <span>{part.text}</span>
            ),
          )}
        </p>
      </section>
    ))}
    {editorPreview && !entries.length && <p>{emptyMessage}</p>}
  </div>
  {closing && appearance?.contact?.enabled && (
    <ClosingInvitation
      cta={{ ...config.cta, destination: '/contact' }}
      section="policies-cta"
    />
  )}
  {closing && editorPreview && !appearance?.contact?.enabled && (
    <p data-editor-section="policies-cta">
      Enable Contact to show the closing invitation.
    </p>
  )}
</article>
