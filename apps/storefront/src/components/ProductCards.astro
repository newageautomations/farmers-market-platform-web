---
import { cardClassName } from '@market/ui/presentation';
import type { PublicCatalog, VendorPreorderAvailability } from '@market/api';
import { FeaturedAdd } from './FeaturedAdd';
import type { StorefrontThemeId } from '@market/theme/storefront';
import Button from './ui/Button.astro';
import HarvestArtwork from './home/HarvestArtwork.astro';
import MeadowArt from './meadow/Art.astro';
import HearthArt from './hearth/Art.astro';
import { usesHarvestContract } from '@market/theme/storefront';
import {
  safeAsset,
  plainDescription,
  priceLabel,
  productPreorder,
} from '@market/storefront-core';
interface Props {
  items: PublicCatalog['items'];
  editorialFeatured?: boolean;
  carousel?: boolean;
  featured?: boolean;
  storefrontId?: string;
  shop?: boolean;
  occurrenceId?: string;
  availability?: VendorPreorderAvailability;
  preview?: boolean;
  theme?: StorefrontThemeId;
  sellerName?: string;
  sellerNames?: Record<string, string>;
  productLinks?: Record<string, string>;
  market?: boolean;
}
const {
  items,
  editorialFeatured = false,
  carousel = false,
  featured = false,
  storefrontId,
  shop = false,
  occurrenceId,
  availability = [],
  preview = false,
  theme = 'harvest',
  sellerName,
  sellerNames,
  productLinks,
  market = false,
} = Astro.props;
// Meadow and Hearth share the Harvest product card structure with their own placeholder art.
const harvestCards = usesHarvestContract(theme);
const productLink = (slug: string) =>
  `/products/${encodeURIComponent(slug)}${occurrenceId && !preview ? `?occurrence=${encodeURIComponent(occurrenceId)}` : ''}`;
---

<div
  data-carousel-track={carousel ? true : undefined}
  tabindex={carousel ? 0 : undefined}
  class:list={[
    'catalog-grid',
    editorialFeatured && 'em-products',
    harvestCards && (featured || shop) && 'harvest-products',
    theme === 'modern-farmhouse' && 'mf-products',
    theme === 'editorial-market' && !editorialFeatured && 'em-shop-products',
    shop && 'shop-products',
  ]}
>
  {items.map((product) => {
    const status = productPreorder(product.variants, availability);
    const href = productLinks?.[product.id] ?? productLink(product.slug);
    const seller = sellerNames?.[product.id] ?? sellerName;
    return (
      <article
        class={
          editorialFeatured
            ? 'product-card em-product-card'
            : cardClassName({
                className: `product-card card${shop && !status.available ? ' shop-product-unavailable' : ''}`,
                spacing: 'contained',
                padding: 'default',
                surface: theme === 'modern-farmhouse' ? 'embedded' : 'card',
              })
        }
      >
        <a class="product-card-link" href={href}>
          <span
            class:list={[
              editorialFeatured
                ? 'em-product-image'
                : theme === 'editorial-market'
                  ? 'em-shop-image-frame'
                  : 'product-image-contents',
            ]}
          >
            {safeAsset(product.featuredAsset?.preview) ? (
              <img
                class="product-media"
                src={safeAsset(product.featuredAsset?.preview)}
                alt=""
                width="640"
                height="480"
                loading="lazy"
              />
            ) : (
              <div
                class={
                  editorialFeatured
                    ? 'em-product-placeholder'
                    : 'product-media product-placeholder'
                }
                aria-hidden="true"
              >
                {editorialFeatured ? (
                  '✦'
                ) : theme === 'meadow' && (featured || shop) ? (
                  <MeadowArt name="basket" />
                ) : theme === 'hearth' && (featured || shop) ? (
                  <HearthArt name="basket" />
                ) : (theme === 'harvest' || theme === 'bloom') &&
                  (featured || shop) ? (
                  <HarvestArtwork />
                ) : (
                  'No image'
                )}
              </div>
            )}
          </span>
          {featured || editorialFeatured ? (
            <h3>
              <span class:list={[market && !shop && 'farmstand-text-link']}>
                {product.name}
              </span>
            </h3>
          ) : (
            <h2 class="ui-section-title-consumer">
              <span class:list={[market && !shop && 'farmstand-text-link']}>
                {product.name}
              </span>
            </h2>
          )}
        </a>
        {seller && <p class="product-seller">{seller}</p>}
        <p>{priceLabel(product.variants)}</p>
        {!shop && !editorialFeatured && (
          <p>{plainDescription(product.description).slice(0, 160)}</p>
        )}
        {shop && (
          <>
            <p class="shop-availability">
              {!occurrenceId ? 'No upcoming pickup market' : status.reason}
            </p>
            {status.available && occurrenceId && !preview ? (
              status.variantId && storefrontId ? (
                <FeaturedAdd
                  storefrontId={storefrontId}
                  variantId={status.variantId}
                  occurrenceId={occurrenceId}
                  market={market}
                  client:load
                />
              ) : (
                <Button href={href} variant="secondary">
                  Choose options
                </Button>
              )
            ) : (
              <Button disabled>
                {preview && status.available ? 'Preview only' : 'Unavailable'}
              </Button>
            )}
          </>
        )}
        {featured &&
          (product.variants.length === 1 && storefrontId ? (
            <FeaturedAdd
              storefrontId={storefrontId}
              variantId={product.variants[0]!.id}
              client:load
            />
          ) : (
            <Button
              href={`/products/${encodeURIComponent(product.slug)}`}
              variant="secondary"
            >
              {product.variants.length ? 'Choose options' : 'View product'}
            </Button>
          ))}
        {!featured && !shop && !!product.facetValues.length && (
          <p class="facet-tags">
            {product.facetValues.map((f) => f.name).join(' · ')}
          </p>
        )}
      </article>
    );
  })}
</div>
