---
/**
 * Meadow's illustration set: flat, decorative artwork drawn for this theme.
 * Every drawing shares one 96 x 96 frame, so it can stand alone as a sticker
 * or be placed inside a larger scene with `x`, `y` and `size`.
 */
import type { MeadowArtName } from './art';
interface Props {
  name: MeadowArtName;
  /** Position and size when nested inside another SVG scene. */
  x?: number;
  y?: number;
  size?: number;
  class?: string;
}
const { name, x, y, size, class: className } = Astro.props;
const petals = Array.from({ length: 12 }, (_, index) => index * 30);
