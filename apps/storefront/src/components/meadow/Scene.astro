---
import Art from './Art.astro';
/**
 * Meadow's hero illustration: a market stall in a sunny field. Decorative
 * only. `bunting` strings festive flags across it for Market Day mode.
 */
interface Props {
  bunting?: boolean;
}
const { bunting = false } = Astro.props;
const stripes = Array.from({ length: 7 }, (_, index) => 150 + index * 40);
const slats = [212, 264, 316, 368];
const flagColors = ['#E4492F', '#F5B82E', '#3E8E4B', '#4A9CC7', '#F28A2E'];
// Points along the bunting string M0 30 Q280 110 560 30.
const flags = Array.from({ length: 9 }, (_, index) => {
  const t = (index + 1) / 10;
  return { x: 560 * t, y: 30 + 160 * t * (1 - t) };
});
const daisies = [
  [36, 462],
  [128, 478],
  [214, 468],
  [338, 480],
  [420, 466],
  [530, 474],
];
---

<svg
  class="mw-scene"
  viewBox="0 0 560 500"
  aria-hidden="true"
  focusable="false"
>
  <g class="mw-scene-sun">
    <circle cx="440" cy="100" r="80" fill="#FFD24D" opacity=".28"></circle>
    <circle cx="440" cy="100" r="56" fill="#FFD24D"></circle>
  </g>
  <g class="mw-scene-clouds" fill="#fff">
    <path
      d="M52 118a22 22 0 0 1 41-10 19 19 0 0 1 31 9 17 17 0 0 1-3 33H60a17 17 0 0 1-8-32z"
      opacity=".95"
    ></path>
    <path
      d="M286 62a16 16 0 0 1 30-7 14 14 0 0 1 23 7 12 12 0 0 1-2 24h-46a12 12 0 0 1-5-24z"
      opacity=".8"
    ></path>
  </g>
  <path
    d="M0 356c70-66 170-86 270-48 82 31 172 20 290-40v232H0z"
    fill="#D5ECC0"
  ></path>
  <path
    d="M0 420c92-48 202-54 302-24 90 27 180 22 258-16v120H0z"
    fill="#9BD184"
  ></path>
  <path d="M0 468c120-30 420-30 560 0v32H0z" fill="#57A866"></path>

  <g class="mw-scene-stall">
    <rect x="168" y="230" width="10" height="212" fill="#8A5A2B"></rect>
    <rect x="402" y="230" width="10" height="212" fill="#8A5A2B"></rect>
    <rect
      x="178"
      y="232"
      width="224"
      height="110"
      fill="#2F6B3A"
      opacity=".1"
    ></rect>
    {stripes.map((x, index) => (
      <path
        d={`M${x} 184h40v46a20 20 0 0 1-40 0z`}
        fill={index % 2 ? '#FFF6E6' : '#E4492F'}
      />
    ))}
    <rect x="140" y="168" width="300" height="20" rx="10" fill="#B8402A"></rect>

    <rect x="170" y="306" width="88" height="34" rx="6" fill="#D9A05B"></rect>
    <circle cx="190" cy="300" r="15" fill="#E4492F"></circle>
    <circle cx="216" cy="295" r="16" fill="#E4492F"></circle>
    <circle cx="241" cy="301" r="14" fill="#F28A2E"></circle>
    <path d="M216 281c-1-6 3-10 8-11 0 6-3 10-8 11z" fill="#2F6B3A"></path>
    <path d="M190 287c-1-5 2-9 7-10 0 5-2 9-7 10z" fill="#2F6B3A"></path>

    <rect x="270" y="312" width="70" height="28" rx="6" fill="#C98B4A"></rect>
    <ellipse
      cx="287"
      cy="298"
      rx="10"
      ry="19"
      transform="rotate(-18 287 298)"
      fill="#3E8E4B"
    ></ellipse>
    <ellipse cx="305" cy="293" rx="11" ry="22" fill="#57A866"></ellipse>
    <ellipse
      cx="323"
      cy="298"
      rx="10"
      ry="19"
      transform="rotate(18 323 298)"
      fill="#3E8E4B"
    ></ellipse>
    <Art name="honey" x={346} y={280} size={60} />

    <rect x="150" y="338" width="280" height="20" rx="7" fill="#B9772B"></rect>
    <rect x="160" y="358" width="260" height="86" rx="4" fill="#E0A458"></rect>
    {slats.map((x) => (
      <path d={`M${x} 358v86`} stroke="#C98B4A" stroke-width="3" />
    ))}
    <rect x="248" y="376" width="84" height="46" rx="12" fill="#FFF6E6"></rect>
    <path d="m290 385 12 7v14l-12 7-12-7v-14z" fill="#F5B82E"></path>
  </g>

  {daisies.map(([x, y]) => (
    <g>
      <circle cx={x} cy={y} r="6" fill="#fff" />
      <circle cx={x} cy={y} r="2.5" fill="#F5B82E" />
    </g>
  ))}

  <g class="mw-scene-sway">
    <Art name="sunflower" x={436} y={316} size={132} />
  </g>
  <g class="mw-scene-sway mw-scene-sway-late">
    <Art name="sunflower" x={494} y={356} size={96} />
  </g>
  <g class="mw-scene-hen">
    <Art name="hen" x={40} y={354} size={108} />
  </g>

  <path
    d="M132 206c28 20 40-24 72-6"
    stroke="#C9860A"
    stroke-width="2.5"
    stroke-dasharray="1 9"
    stroke-linecap="round"
    fill="none"
  ></path>
  <g class="mw-scene-bee">
    <g transform="translate(200 0) scale(-1 1)">
      <Art name="bee" x={72} y={176} size={56} />
    </g>
  </g>
  <path
    d="M454 262c-22-18-10-40 8-36"
    stroke="#C9860A"
    stroke-width="2.5"
    stroke-dasharray="1 9"
    stroke-linecap="round"
    fill="none"
  ></path>
  <g class="mw-scene-bee mw-scene-bee-late">
    <Art name="bee" x={468} y={196} size={42} />
  </g>

  {bunting && (
    <g class="mw-scene-bunting">
      <path
        d="M0 30Q280 110 560 30"
        stroke="#8A5A2B"
        stroke-width="2.5"
        fill="none"
      />
      {flags.map((flag, index) => (
        <path
          d={`M${flag.x - 17} ${flag.y - 1}h34l-17 32z`}
          fill={flagColors[index % flagColors.length]}
        />
      ))}
    </g>
  )}
</svg>
