---
import EmptyState from './ui/EmptyState.astro';
import { buttonClassName, cardClassName } from '@market/ui/presentation';
import type { StorefrontContext } from '@market/storefront-core';
import { occurrenceLabel } from '@market/storefront-core';
import type { PublicMarketOccurrence, AppError } from '@market/api';
import { ErrorState } from '@market/ui';
interface Props {
  context: StorefrontContext;
  occurrences: readonly PublicMarketOccurrence[];
  totalItems: number;
  page: number;
  error?: AppError;
  advertisedApplication?: boolean;
}
const { context, occurrences, totalItems, page, error, advertisedApplication } =
  Astro.props;
---

<div data-composition="market">
  <section class="hero" aria-labelledby="market-title">
    <div>
      <h1 id="market-title">{context.name}</h1>
      <p>
        Choose a Market occurrence to explore its offerings and shop by Vendor.
      </p>
      {occurrences[0] && page === 1 && (
        <div class="actions">
          <a
            class={buttonClassName({ variant: 'primary', className: 'button' })}
            href={`/occurrences/${occurrences[0].id}`}
          >
            Browse the next occurrence
          </a>
        </div>
      )}
      {advertisedApplication && (
        <a
          class={buttonClassName({
            variant: 'secondary',
            className: 'button secondary',
          })}
          href="/apply"
        >
          Apply to this Market
        </a>
      )}
    </div>
  </section>
  <section
    id="occurrences"
    class="market-occurrences"
    aria-labelledby="occurrences-title"
  >
    <h2 class="ui-section-title-consumer" id="occurrences-title">
      Upcoming occurrences
    </h2>
    {error ? (
      <ErrorState error={error} />
    ) : !occurrences.length ? (
      <EmptyState title="No upcoming occurrences" level={3}>
        <p>No upcoming occurrences are currently listed.</p>
      </EmptyState>
    ) : (
      <ul class="occurrence-list">
        {occurrences.map((occurrence) => (
          <li
            class={cardClassName({ className: 'card', spacing: 'contained' })}
          >
            <h3>
              <a href={`/occurrences/${occurrence.id}`}>
                {occurrenceLabel(occurrence)}
              </a>
            </h3>
            {occurrence.venue && <p>{occurrence.venue}</p>}
            <a
              class={buttonClassName({
                variant: 'secondary',
                className: 'button secondary',
              })}
              href={`/occurrences/${occurrence.id}`}
            >
              Explore this occurrence
            </a>
          </li>
        ))}
      </ul>
    )}
    <nav class="pagination ui-pagination" aria-label="Occurrence pages">
      <p>
        {totalItems} occurrences. Showing{' '}
        {occurrences.length ? (page - 1) * 8 + 1 : 0} to{' '}
        {occurrences.length ? (page - 1) * 8 + occurrences.length : 0}.
      </p>
      {page > 1 && (
        <a
          class={buttonClassName({ variant: 'secondary' })}
          href={`/?occurrencePage=${page - 1}#occurrences`}
        >
          Previous occurrences
        </a>
      )}
      {page * 8 < totalItems && (
        <a
          class={buttonClassName({ variant: 'secondary' })}
          href={`/?occurrencePage=${page + 1}#occurrences`}
        >
          More occurrences
        </a>
      )}
    </nav>
  </section>
</div>
