---
import EmptyState from './ui/EmptyState.astro';
import Button from './ui/Button.astro';
import { SectionHeader, ErrorState } from '@market/ui';
import type { StorefrontContext } from '@market/storefront-core';
import {
  taxonomyNavigation,
  occurrenceLabel,
  safeAsset,
} from '@market/storefront-core';
import {
  harvestHomepageTarget,
  marketOriginalSections,
  marketText,
} from '@market/theme/storefront';
import type {
  PublicMarketOccurrence,
  MarketCatalog,
  MarketOccurrenceVendor,
  AppError,
} from '@market/api';
import HarvestHero from './home/HarvestHero.astro';
import HarvestArtwork from './home/HarvestArtwork.astro';
import WebsiteSections from './WebsiteSections.astro';
import MarketDateList from './market/MarketDateList.astro';
import MarketVendorCards from './market/MarketVendorCards.astro';
import { marketPageAvailable } from '../lib/market-website';
import '../styles/harvest-sections.css';
import '../styles/market-website.css';
interface Props {
  context: StorefrontContext;
  occurrences: readonly PublicMarketOccurrence[];
  catalog?: MarketCatalog;
  vendors?: readonly MarketOccurrenceVendor[];
  error?: AppError;
  advertisedApplication?: boolean;
}
const { context, occurrences, catalog, vendors, error } = Astro.props;
const appearance = context.appearance;
const preview = !!Astro.locals.editorPreview;
const composition =
  appearance?.harvestComposition ??
  marketOriginalSections.map((id) => ({ id }));
const next = occurrences[0];
const datesPage = marketPageAvailable(appearance, 'market-dates', preview);
const vendorsPage = marketPageAvailable(appearance, 'vendors', preview);
const datesHref = datesPage
  ? '/market-dates'
  : next
    ? `/shop?occurrence=${next.id}`
    : '#markets';
const shownVendors = (
  vendors ??
  catalog?.vendors.map((vendor) => ({
    vendorId: vendor.vendorId,
    name: vendor.vendorName,
    image: null,
    storefrontUrl: null,
    offeringCount: vendor.count,
  })) ??
  []
).slice(0, 8);
const categories = catalog?.taxonomy
  ? taxonomyNavigation(catalog.taxonomy, appearance?.categoryPresentation)
  : [];
---

<div data-composition="market">
  {composition.map((entry) =>
    'type' in entry ? (
      <WebsiteSections
        context={context}
        sections={[entry]}
        target={harvestHomepageTarget}
        prefix="harvest"
      />
    ) : entry.id === 'hero' ? (
      <HarvestHero
        context={context}
        image={
          catalog?.items.find((item) => item.featuredAsset?.preview)
            ?.featuredAsset?.preview
        }
        href={appearance?.market?.heroPrimaryDestination ?? datesHref}
        action="Find your next market day"
        secondaryHref={
          appearance?.market?.heroSecondaryDestination ??
          (vendorsPage ? '/vendors' : '#vendors')
        }
      >
        {next && (
          <div slot="details" class="harvest-next-visit">
            <span class="harvest-visit-mark" aria-hidden="true">
              &#8599;
            </span>
            <div>
              <p>{occurrenceLabel(next)}</p>
              {next.venue && <p>{next.venue}</p>}
            </div>
          </div>
        )}
      </HarvestHero>
    ) : entry.id === 'markets' ? (
      <section
        id="markets"
        class="harvest-section"
        data-editor-section="markets"
        aria-labelledby="markets-title"
      >
        <SectionHeader
          title={marketText(appearance, 'marketsHeading')}
          id="markets-title"
          variant="consumer"
        >
          {datesPage && (
            <a href="/market-dates">
              <span data-market-text="marketsLinkLabel">
                {marketText(appearance, 'marketsLinkLabel')}
              </span>{' '}
              &#8599;
            </a>
          )}
        </SectionHeader>
        <p class="market-section-intro" data-market-text="marketsText">
          {marketText(appearance, 'marketsText')}
        </p>
        {error ? (
          <ErrorState error={error} />
        ) : !occurrences.length ? (
          <EmptyState title="Your next visit is in the making" level={3}>
            <p>
              Upcoming market dates will appear here when they are announced.
            </p>
          </EmptyState>
        ) : (
          <MarketDateList
            occurrences={occurrences}
            cardTheme={appearance?.market?.marketsCardTheme}
          />
        )}
      </section>
    ) : entry.id === 'vendors' ? (
      <section
        id="vendors"
        class="harvest-section"
        data-editor-section="vendors"
        aria-labelledby="vendors-title"
      >
        <SectionHeader
          title={marketText(appearance, 'vendorsHeading')}
          id="vendors-title"
          variant="consumer"
        >
          {vendorsPage && (
            <a href="/vendors">
              <span data-market-text="vendorsLinkLabel">
                {marketText(appearance, 'vendorsLinkLabel')}
              </span>{' '}
              &#8599;
            </a>
          )}
        </SectionHeader>
        <p class="market-section-intro" data-market-text="vendorsText">
          {marketText(appearance, 'vendorsText')}
        </p>
        {next && shownVendors.length ? (
          <MarketVendorCards
            vendors={shownVendors}
            occurrenceId={next.id}
            cardTheme={appearance?.market?.vendorsCardTheme}
          />
        ) : (
          <EmptyState title="Meet us at the next market" level={3}>
            <p>
              Participating vendors will appear here as the next market date
              takes shape.
            </p>
          </EmptyState>
        )}
      </section>
    ) : entry.id === 'categories' ? (
      (categories.length > 0 || preview) && (
        <section
          class="harvest-section harvest-library harvest-category-showcase market-categories"
          data-editor-section="categories"
          data-layout="cards"
          data-background="surface"
          aria-labelledby="categories-title"
        >
          <div class="harvest-library-heading">
            <h2 id="categories-title" data-market-text="categoriesHeading">
              {marketText(appearance, 'categoriesHeading')}
            </h2>
            <p data-market-text="categoriesText">
              {marketText(appearance, 'categoriesText')}
            </p>
          </div>
          {next && categories.length ? (
            <nav
              class="harvest-category-links"
              aria-label="Categories for the next market date"
            >
              {categories.slice(0, 6).map((category) => (
                <a
                  href={`/shop?occurrence=${next.id}&category=${encodeURIComponent(category.id)}`}
                >
                  <span class="harvest-category-photo">
                    {safeAsset(category.image) ? (
                      <img
                        src={safeAsset(category.image)}
                        alt=""
                        width="800"
                        height="600"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <HarvestArtwork />
                    )}
                  </span>
                  <span class="harvest-category-title farmstand-text-link">
                    {category.name}
                    <span aria-hidden="true"> &#8599;</span>
                  </span>
                </a>
              ))}
            </nav>
          ) : (
            <p>
              Categories appear when vendors list offerings for your next market
              date.
            </p>
          )}
        </section>
      )
    ) : (
      <section
        class="harvest-invitation market-cta-banner"
        data-editor-section="closing"
        aria-labelledby="market-cta-title"
      >
        <div>
          <h2
            id="market-cta-title"
            style="white-space:pre-line"
            data-market-text="closingHeading"
          >
            {marketText(appearance, 'closingHeading')}
          </h2>
          <p data-market-text="closingText">
            {marketText(appearance, 'closingText')}
          </p>
        </div>
        <Button href={datesHref}>
          <span data-market-text="closingLabel">
            {marketText(appearance, 'closingLabel')}
          </span>{' '}
          <span aria-hidden="true">&#8599;</span>
        </Button>
      </section>
    ),
  )}
</div>
