---
import EmptyState from './ui/EmptyState.astro';
import Button from './ui/Button.astro';
import { cardClassName } from '@market/ui/presentation';
import { SectionHeader, ErrorState } from '@market/ui';
import type { StorefrontContext } from '@market/storefront-core';
import { taxonomyNavigation, occurrenceLabel } from '@market/storefront-core';
import type {
  PublicMarketOccurrence,
  MarketCatalog,
  AppError,
} from '@market/api';
import HarvestHero from './home/HarvestHero.astro';
interface Props {
  context: StorefrontContext;
  occurrences: readonly PublicMarketOccurrence[];
  totalItems: number;
  page: number;
  catalog?: MarketCatalog;
  error?: AppError;
  advertisedApplication?: boolean;
}
const {
  context,
  occurrences,
  totalItems,
  page,
  catalog,
  error,
  advertisedApplication,
} = Astro.props;
const next = occurrences[0];
const nextHref = next ? `/occurrences/${next.id}` : '#occurrences';
const vendors = catalog?.vendors ?? [];
const categories = catalog?.taxonomy
  ? taxonomyNavigation(
      catalog.taxonomy,
      context.appearance?.categoryPresentation,
    )
  : [];
const dateParts = (value: PublicMarketOccurrence) => {
  const date = new Date(value.startsAt);
  return {
    month: new Intl.DateTimeFormat('en-US', {
      month: 'short',
      timeZone: value.timezone,
    }).format(date),
    day: new Intl.DateTimeFormat('en-US', {
      day: 'numeric',
      timeZone: value.timezone,
    }).format(date),
  };
};
---

<div data-composition="market">
  <HarvestHero
    context={context}
    image={
      catalog?.items.find((item) => item.featuredAsset?.preview)?.featuredAsset
        ?.preview
    }
    href={nextHref}
    action={next ? 'Explore the next market' : 'Plan your visit'}
  >
    {advertisedApplication && (
      <Button slot="action" href="/apply" variant="secondary">
        Become a vendor
      </Button>
    )}
    {next && (
      <div slot="details" class="harvest-next-visit">
        <span class="harvest-visit-mark" aria-hidden="true">
          ↗
        </span>
        <div>
          <p>{occurrenceLabel(next)}</p>
          {next.venue && <p>{next.venue}</p>}
        </div>
      </div>
    )}
  </HarvestHero>
  <section
    id="occurrences"
    class="harvest-section"
    aria-labelledby="occurrences-title"
  >
    <SectionHeader
      title="A good day starts at the market."
      id="occurrences-title"
      variant="consumer"
    >
      <p>Pick a date. Meet the makers. Find something wonderful.</p>
    </SectionHeader>
    {error ? (
      <ErrorState error={error} />
    ) : !occurrences.length ? (
      <EmptyState title="Your next visit is in the making" level={3}>
        <p>Upcoming market dates will appear here when they are announced.</p>
      </EmptyState>
    ) : (
      <ul class="harvest-dates">
        {occurrences.map((occurrence) => (
          <li
            class={cardClassName({
              spacing: 'contained',
              className: 'harvest-date',
            })}
          >
            <div class="harvest-date-stamp" aria-hidden="true">
              <span>{dateParts(occurrence).month}</span>
              <strong>{dateParts(occurrence).day}</strong>
            </div>
            <div>
              <h3>
                <a href={`/occurrences/${occurrence.id}`}>
                  {occurrenceLabel(occurrence)}
                </a>
              </h3>
              {occurrence.venue && <p>{occurrence.venue}</p>}
              <a
                class="harvest-text-link"
                href={`/occurrences/${occurrence.id}`}
              >
                Explore this market <span aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}
    {(totalItems > 8 || page > 1) && (
      <nav class="pagination ui-pagination" aria-label="Market date pages">
        <p>
          {totalItems} market dates. Showing{' '}
          {occurrences.length ? (page - 1) * 8 + 1 : 0} to{' '}
          {occurrences.length ? (page - 1) * 8 + occurrences.length : 0}.
        </p>
        {page > 1 && (
          <Button
            href={`/?occurrencePage=${page - 1}#occurrences`}
            variant="secondary"
          >
            Previous dates
          </Button>
        )}
        {page * 8 < totalItems && (
          <Button
            href={`/?occurrencePage=${page + 1}#occurrences`}
            variant="secondary"
          >
            More market dates
          </Button>
        )}
      </nav>
    )}
  </section>
  {next && categories.length > 0 && (
    <nav
      class="harvest-section market-filter-options"
      aria-label="Categories for the next market date"
    >
      {categories.map((category) => (
        <a
          href={`/occurrences/${next.id}?category=${encodeURIComponent(category.id)}`}
        >
          {category.image && (
            <img
              src={category.image}
              alt=""
              width="80"
              height="80"
              loading="lazy"
            />
          )}
          {category.name}
        </a>
      ))}
    </nav>
  )}
  <section id="vendors" class="harvest-section" aria-labelledby="vendors-title">
    <SectionHeader
      title="Get to know your local favorites."
      id="vendors-title"
      variant="consumer"
    >
      <p>
        {next
          ? 'Discover vendors with offerings at this market date.'
          : 'Discover the people behind your next market find.'}
      </p>
    </SectionHeader>
    {vendors.length && next ? (
      <ul class="harvest-vendors">
        {vendors.slice(0, 8).map((vendor) => (
          <li class={cardClassName({ spacing: 'contained' })}>
            <span class="harvest-vendor-symbol" aria-hidden="true">
              {vendor.vendorName.slice(0, 1)}
            </span>
            <h3>{vendor.vendorName}</h3>
            <a
              href={`/occurrences/${next.id}?vendor=${encodeURIComponent(vendor.vendorId)}`}
            >
              Explore their offerings ↗
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState title="Meet us at the next market" level={3}>
        <p>
          Participating vendors with available offerings will appear here as the
          next market date takes shape.
        </p>
      </EmptyState>
    )}
  </section>
  {context.appearance?.homepage.story && (
    <section
      class="harvest-story harvest-section"
      aria-label="About this market"
    >
      <div>
        <h2>
          More than a market.
          <br />A place to belong.
        </h2>
        {context.appearance.about.enabled && (
          <Button href="/about" variant="secondary">
            Get to know us ↗
          </Button>
        )}
      </div>
      <p>{context.appearance.homepage.story}</p>
    </section>
  )}
  <section class="harvest-invitation" aria-label="Plan your next visit">
    <h2>
      Come for the market.
      <br />
      Stay for the community.
    </h2>
    <Button href="#occurrences">
      Find your next market day <span aria-hidden="true">↗</span>
    </Button>
  </section>
</div>
