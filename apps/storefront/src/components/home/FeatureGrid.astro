---
import type { StorefrontContext } from '@market/storefront-core';
import type { WebsiteFeatureGridSection } from '@market/theme/storefront';
import FarmstandIcon from '../ui/FarmstandIcon.astro';
import '../../styles/harvest-sections.css';
import '../../styles/theme-section-library.css';
import '@market/ui/farmstand.css';
const { section, context, editorId } = Astro.props as {
  section: WebsiteFeatureGridSection;
  context?: StorefrontContext;
  editorId?: string;
};
const { content: c, presentation: p } = section;
const theme = context?.appearance?.theme ?? 'harvest';
const prefix =
  theme === 'modern-farmhouse'
    ? 'farmhouse'
    : theme === 'editorial-market'
      ? 'editorial'
      : 'harvest';
---

<section
  class="harvest-section harvest-library harvest-features"
  data-library-theme={theme}
  data-editor-section={editorId ?? `${prefix}:${section.id}`}
  data-background-type={p.backgroundType ?? 'contained'}
  data-background={p.background}
  data-spacing={p.spacing}
  data-alignment={p.alignment}
  data-columns={p.columns}
  data-icon-position={p.iconPosition}
  data-card-style={p.cardStyle}
  style={`--harvest-feature-icon-size:${typeof p.iconSize === 'number' && Number.isInteger(p.iconSize) && p.iconSize >= 16 && p.iconSize <= 96 ? p.iconSize : 40}px`}
>
  <header class="harvest-library-heading">
    {c.heading && <h2>{c.heading}</h2>}
    {c.body && <p>{c.body}</p>}
  </header>
  <div class="harvest-feature-items">
    {c.items.map((item) => (
      <article>
        {item.icon && <FarmstandIcon name={item.icon} />}
        <div>
          {item.title && <h3>{item.title}</h3>}
          {item.description && <p>{item.description}</p>}
        </div>
      </article>
    ))}
  </div>
</section>
