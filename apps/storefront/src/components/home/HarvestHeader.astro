---
import type { StorefrontContext } from '@market/storefront-core';
import { MarketCartLink } from '../MarketCartLink';
import FarmstandIcon from '../ui/FarmstandIcon.astro';
import HeaderAccountMenu from './HeaderAccountMenu.astro';
import { buttonClassName } from '@market/ui/presentation';
import { storefrontText, themePageStructure } from '@market/theme/storefront';
import { marketNavigation } from '../../lib/market-website';
interface Props {
  context: StorefrontContext;
}
const { context } = Astro.props;
const active = (path: string) =>
  Astro.url.pathname === path ||
  (path === '/products' && Astro.url.pathname.startsWith('/products/')) ||
  (path === '/shop' && Astro.url.pathname.startsWith('/shop/'))
    ? ('page' as const)
    : undefined;
const market = context.kind === 'MARKET';
// Footer-only pages (on the vendor standard: FAQ, Policies, Terms) stay out of the header.
const footerOnly = themePageStructure(context.appearance?.theme, context.kind)
  .footerOnlyPages as readonly string[];
const faqInHeader =
  !!context.appearance?.faq?.enabled && !footerOnly.includes('faq');
const marketLinks = market
  ? marketNavigation(context.appearance, !!Astro.locals.editorPreview)
  : [];
---

<header class="harvest-header" data-editor-section="header">
  <a class="harvest-brand" href="/" aria-label={`${context.name} home`}>
    {context.theme.logo && (
      <img src={context.theme.logo} alt="" width="40" height="40" />
    )}
    <span class:list={[market && 'farmstand-text-link']}>{context.name}</span>
  </a>
  <nav class="harvest-desktop-nav" aria-label="Main navigation">
    {market ? (
      marketLinks.map((link) => (
        <a href={link.href} aria-current={active(link.href)}>
          {link.label}
        </a>
      ))
    ) : (
      <a aria-current={active('/products')} href="/products">
        <span data-storefront-text="headerShopLabel">
          {storefrontText(context.appearance, 'headerShopLabel')}
        </span>
      </a>
    )}
    {faqInHeader && (
      <a href="/faq" aria-current={active('/faq')}>
        {context.appearance!.faq!.title}
      </a>
    )}
    {context.appearance?.contact?.enabled && (
      <a href="/contact" aria-current={active('/contact')}>
        {context.appearance.contact.title}
      </a>
    )}
    {!market && context.appearance?.findUs?.enabled && (
      <a href="/find-us" aria-current={active('/find-us')}>
        Find Us
      </a>
    )}
    {context.appearance?.about.enabled && (
      <a href="/about" aria-current={active('/about')}>
        <span data-storefront-text="headerAboutLabel">
          {storefrontText(context.appearance, 'headerAboutLabel')}
        </span>
      </a>
    )}
  </nav>
  <div class="harvest-header-actions">
    <details class="harvest-mobile-menu">
      <summary aria-label="Open navigation menu">
        Menu <span aria-hidden="true">☰</span>
      </summary>
      <nav aria-label="Mobile navigation">
        <a href="/" aria-current={active('/')}>
          Home
        </a>
        {market ? (
          marketLinks.map((link) => (
            <a href={link.href} aria-current={active(link.href)}>
              {link.label}
            </a>
          ))
        ) : (
          <a href="/products" aria-current={active('/products')}>
            <span data-storefront-text="headerShopLabel">
              {storefrontText(context.appearance, 'headerShopLabel')}
            </span>
          </a>
        )}
        {faqInHeader && (
          <a href="/faq" aria-current={active('/faq')}>
            {context.appearance!.faq!.title}
          </a>
        )}
        {context.appearance?.contact?.enabled && (
          <a href="/contact" aria-current={active('/contact')}>
            {context.appearance.contact.title}
          </a>
        )}
        {!market && context.appearance?.findUs?.enabled && (
          <a href="/find-us" aria-current={active('/find-us')}>
            Find Us
          </a>
        )}
        {context.appearance?.about.enabled && (
          <a href="/about" aria-current={active('/about')}>
            <span data-storefront-text="headerAboutLabel">
              {storefrontText(context.appearance, 'headerAboutLabel')}
            </span>
          </a>
        )}
      </nav>
    </details>
    {context.source === 'backend' && !Astro.locals.editorPreview ? (
      <MarketCartLink
        storefrontId={context.storefrontId ?? ''}
        icon
        client:load
      />
    ) : (
      <a
        href="/cart"
        class={buttonClassName({
          variant: 'tertiary',
          iconOnly: true,
          className: 'harvest-cart-link harvest-header-icon',
        })}
        aria-label="Cart, 0 items"
      >
        <FarmstandIcon name="shopping-bag" />
        <span class="harvest-cart-count" aria-hidden="true">
          0
        </span>
      </a>
    )}
    <HeaderAccountMenu />
  </div>
</header>
<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    '.harvest-mobile-menu',
  )) {
    const summary = menu.querySelector('summary');
    summary?.setAttribute('aria-expanded', 'false');
    menu.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(menu.open));
      summary?.setAttribute(
        'aria-label',
        menu.open ? 'Close navigation menu' : 'Open navigation menu',
      );
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target))
        menu.open = false;
    });
  }
</script>
