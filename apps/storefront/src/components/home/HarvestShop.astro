---
import type { AppError, PublicCatalog, StorefrontTaxonomy } from '@market/api';
import type { StorefrontContext } from '@market/storefront-core';
import {
  taxonomyNavigation,
  productPreorder,
  safeAsset,
  SHOP_PAGE_SIZE,
} from '@market/storefront-core';
import { isEditorialMarket } from '@market/theme/storefront';
import {
  cardClassName,
  selectClassName,
  buttonClassName,
} from '@market/ui/presentation';
import { ErrorState } from '@market/ui';
import type { VendorPreorderState } from '../../lib/vendor-preorder';
import ProductCards from '../ProductCards.astro';
import { ShopMarketSelection } from '../ShopMarketSelection';
import VendorPreorderBanner from '../VendorPreorderBanner.astro';
import Button from '../ui/Button.astro';
import '../../styles/vendor-shop.css';

// Shared Harvest composition. Commerce reads and eligibility stay with each route.
interface Props {
  context?: StorefrontContext;
  error?: AppError;
  items: PublicCatalog['items'];
  visible: PublicCatalog['items'];
  total: number;
  page: number;
  sort: string;
  category: string;
  search: string;
  categories: ReturnType<typeof taxonomyNavigation>;
  taxonomy?: StorefrontTaxonomy;
  query: URLSearchParams;
  preorder: VendorPreorderState;
  preview?: boolean;
  market?: boolean;
  /**
   * Editorial Market market shop: the page renders the editorial shop artwork
   * and category strip, and the header owns market date selection on desktop.
   */
  editorialChrome?: boolean;
  sellerNames?: Record<string, string>;
  productLinks?: Record<string, string>;
  sortOptions?: { value: string; label: string }[];
  link: (next: { category?: string; page?: number }) => string;
}
const {
  context: storefront,
  error,
  items,
  visible,
  total,
  page,
  sort,
  category,
  search,
  categories,
  query,
  preorder,
  preview = false,
  market = false,
  editorialChrome = false,
  sellerNames,
  productLinks,
  link,
  sortOptions = [
    { value: 'default', label: 'Catalog order' },
    { value: 'name', label: 'Name A to Z' },
  ],
} = Astro.props;
const selected = preorder.selected;
const sortedCategories = categories
  .map((c) => ({ ...c, label: `${c.pathNames.at(-1) ?? c.name} (${c.count})` }))
  .sort((a, b) =>
    a.label.localeCompare(b.label, 'en', {
      sensitivity: 'base',
      numeric: true,
    }),
  );
const selectedCategories = query.getAll('category');
const categoryPreserve = [...query.entries()].filter(
  ([key]) => !['category', 'page'].includes(key),
);
const skip = (page - 1) * SHOP_PAGE_SIZE;
const heading =
  categories.find((c) => c.id === category)?.name ??
  (category ? 'Products' : 'All Products');
const noneAvailable =
  visible.length > 0 &&
  selected &&
  !preorder.unavailable &&
  visible.every(
    (p) => !productPreorder(p.variants, preorder.availability).available,
  );
---

<section
  class="vendor-shop"
  data-composition={market ? 'market' : 'vendor'}
  data-editorial-chrome={editorialChrome ? 'true' : undefined}
  aria-label="Shop products for market pickup"
>
  {error ? (
    <>
      <h1>Shop unavailable</h1>
      <ErrorState error={error} />
    </>
  ) : (
    <>
      {storefront?.appearance?.theme === 'modern-farmhouse' && (
        <div class="mf-shop-intro">
          <div>
            <h1>{heading}</h1>
            <p>
              Find your next market favorite. Choose a pickup market to see what
              is available.
            </p>
          </div>
          {safeAsset(visible[0]?.featuredAsset?.preview) && (
            <img
              class="product-media"
              src={safeAsset(visible[0]?.featuredAsset?.preview)}
              alt=""
              width="960"
              height="640"
              fetchpriority="high"
            />
          )}
        </div>
      )}
      {storefront &&
        !editorialChrome &&
        isEditorialMarket(storefront.appearance) && (
          <div
            class="em-shop-intro"
            data-editor-section="editorial:shop-settings"
          >
            <h1>{storefront.appearance.template.settings.pages.shopHeading}</h1>
            <p>
              {storefront.appearance.template.settings.pages.shopIntroduction}
            </p>
          </div>
        )}
      <div
        class:list={[
          'shop-market-slot',
          editorialChrome && 'shop-market-header-owned',
        ]}
      >
        <VendorPreorderBanner
          selectionRequired={market}
          preorder={preorder}
          storefrontId={storefront?.storefrontId ?? ''}
          preview={preview}
        />
      </div>
      {market && !selected ? (
        <div class="shop-market-slot shop-date-empty empty-state">
          {editorialChrome ? (
            <h2>Choose a market date to explore the options</h2>
          ) : (
            <h1>Choose a market date to explore the options</h1>
          )}
          {editorialChrome && (
            <p class="shop-market-header-hint">
              Use the market date menu at the top of the page.
            </p>
          )}
          <div class:list={[editorialChrome && 'shop-market-header-owned']}>
            <ShopMarketSelection
              storefrontId={storefront?.storefrontId ?? ''}
              occurrences={preorder.occurrences}
              selectedId=""
              buttonLabel="Choose market"
              preview={preview}
              client:load
            />
          </div>
        </div>
      ) : (
        <>
          {!editorialChrome && (
            <aside
              class={cardClassName({
                className: 'shop-categories',
                spacing: 'contained',
                padding: 'default',
                surface:
                  storefront?.appearance?.theme === 'modern-farmhouse'
                    ? 'embedded'
                    : 'card',
              })}
            >
              <h2 class="ui-section-title-consumer">Product Categories</h2>
              <form
                method="get"
                class="shop-category-filters"
                aria-label="Product categories"
              >
                {categoryPreserve.map(([name, value]) => (
                  <input type="hidden" name={name} value={value} />
                ))}
                <label class="shop-category-option">
                  <input
                    type="checkbox"
                    data-shop-all-categories
                    checked={!selectedCategories.length}
                  />
                  <span>All Products</span>
                </label>
                {sortedCategories.map((c) => (
                  <label class="shop-category-option">
                    <input
                      type="checkbox"
                      name="category"
                      value={c.id}
                      checked={selectedCategories.includes(c.id)}
                    />
                    <span title={c.pathNames.join(' / ')}>{c.label}</span>
                  </label>
                ))}
                <noscript>
                  <Button type="submit" variant="secondary">
                    Apply categories
                  </Button>
                </noscript>
              </form>
            </aside>
          )}
          <div class="shop-catalog">
            <form method="get" class="shop-catalog-controls">
              {selected && (
                <input type="hidden" name="occurrence" value={selected.id} />
              )}
              <div class="shop-catalog-heading">
                {storefront?.appearance?.theme !== 'modern-farmhouse' &&
                  !isEditorialMarket(storefront?.appearance) && (
                    <h1>{heading}</h1>
                  )}
                <span>
                  {total} {total === 1 ? 'product' : 'products'}
                </span>
              </div>
              {query.getAll('category').map((value) => (
                <input type="hidden" name="category" value={value} />
              ))}
              {search && <input type="hidden" name="search" value={search} />}
              {query.getAll('tag').map((value) => (
                <input type="hidden" name="tag" value={value} />
              ))}
              {query.getAll('vendor').map((value) => (
                <input type="hidden" name="vendor" value={value} />
              ))}
              {query.getAll('facet').map((value) => (
                <input type="hidden" name="facet" value={value} />
              ))}
              <div class="field shop-sort">
                <label for="shop-sort">Sort by</label>
                <select id="shop-sort" name="sort" class={selectClassName()}>
                  {sortOptions.map((option) => (
                    <option
                      value={option.value}
                      selected={sort === option.value}
                    >
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
              <Button type="submit" variant="secondary">
                Apply
              </Button>
            </form>
            {preorder.unavailable && selected && (
              <p class="ui-alert ui-alert-info" role="status">
                Availability could not be confirmed. Purchasing is paused until
                you refresh the page.
              </p>
            )}
            {noneAvailable && (
              <p class="ui-alert ui-alert-info" role="status">
                These products cannot currently be preordered for this market.
                Preordering may be closed or products may be sold out. Choose
                another market or check back later.
              </p>
            )}
            {visible.length ? (
              <ProductCards
                theme={storefront?.appearance?.theme}
                items={visible}
                shop
                storefrontId={storefront?.storefrontId}
                occurrenceId={selected?.id}
                availability={preorder.availability}
                preview={preview}
                sellerNames={sellerNames}
                productLinks={productLinks}
                market={market}
              />
            ) : (
              <div class="empty-state">
                <h2 class="ui-section-title-consumer">
                  {!items.length
                    ? 'No products yet'
                    : 'No products in this view'}
                </h2>
                <p>
                  {!items.length
                    ? 'Products will appear here when they are available. Please check back soon.'
                    : 'Choose All Products or return to the first page.'}
                </p>
                {!!items.length && (
                  <Button
                    href={link({ category: '', page: 1 })}
                    variant="secondary"
                  >
                    All Products
                  </Button>
                )}
              </div>
            )}
            {total > SHOP_PAGE_SIZE && (
              <nav class="ui-pagination pagination" aria-label="Shop pages">
                {page > 1 && (
                  <a
                    class={buttonClassName({ variant: 'secondary' })}
                    href={link({ page: page - 1 })}
                  >
                    Previous page
                  </a>
                )}
                <span>
                  Page {page} · {visible.length ? skip + 1 : 0} to{' '}
                  {visible.length ? skip + visible.length : 0} of {total}{' '}
                  products
                </span>
                {skip + SHOP_PAGE_SIZE < total && (
                  <a
                    class={buttonClassName({ variant: 'secondary' })}
                    href={link({ page: page + 1 })}
                  >
                    Next page
                  </a>
                )}
              </nav>
            )}
          </div>
        </>
      )}
    </>
  )}
</section>

<script>
  document.addEventListener('change', (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || input.type !== 'checkbox')
      return;
    const form = input.closest<HTMLFormElement>('.shop-category-filters');
    if (!form) return;
    if (input.hasAttribute('data-shop-all-categories')) {
      form
        .querySelectorAll<HTMLInputElement>('[name="category"]')
        .forEach((category) => {
          category.checked = false;
        });
    }
    form.requestSubmit();
  });
</script>
