---
import type { StorefrontContext } from '@market/storefront-core';
import { safeAsset } from '@market/storefront-core';
import {
  defaultStorefrontAppearance,
  vendorHeroIntroduction,
} from '@market/theme/storefront';
import Button from '../ui/Button.astro';
import HarvestArtwork from './HarvestArtwork.astro';
import { storefrontText } from '@market/theme/storefront';
interface Props {
  context: StorefrontContext;
  image?: string;
  href: string;
  action: string;
}
const { context, image, href, action } = Astro.props;
const home = (context.appearance ?? defaultStorefrontAppearance).homepage;
const media = safeAsset(home.image) ?? safeAsset(image);
const market = context.kind === 'MARKET';
---

<section
  class:list={['harvest-hero', market && 'harvest-hero-market']}
  data-editor-section="hero"
  aria-labelledby="home-title"
>
  <div class="harvest-hero-copy">
    <h1 id="home-title" data-home-text="title">
      {home.title || context.name}
    </h1>
    <p data-home-text="introduction">
      {home.introduction ||
        (market
          ? 'A little closer to the people who grow, make, and bring good things to your community. Find your next market day.'
          : vendorHeroIntroduction)}
    </p>
    <div class="actions harvest-hero-actions">
      <Button href={href}>
        <span data-storefront-text="heroPrimaryLabel">
          {market
            ? action
            : storefrontText(context.appearance, 'heroPrimaryLabel')}
        </span>{' '}
        <span aria-hidden="true">↗</span>
      </Button>
      {context.appearance?.about.enabled && (
        <Button href="/about" variant="tertiary">
          <span data-storefront-text="heroSecondaryLabel">
            {market
              ? 'Our story'
              : storefrontText(context.appearance, 'heroSecondaryLabel')}
          </span>
        </Button>
      )}
      <slot name="action" />
    </div>
    <slot name="details" />
  </div>
  <div
    data-hero-shape={
      !market ? (context.appearance?.vendor?.heroShape ?? 'dome') : undefined
    }
    class:list={['harvest-hero-visual', !media && 'harvest-hero-illustration']}
  >
    {media ? (
      <img
        class="product-media harvest-hero-image"
        src={media}
        alt=""
        width="960"
        height="1120"
        fetchpriority="high"
      />
    ) : (
      <HarvestArtwork />
    )}
    <slot name="caption" />
  </div>
</section>
