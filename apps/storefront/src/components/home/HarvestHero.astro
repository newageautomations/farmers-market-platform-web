---
import type { StorefrontContext } from '@market/storefront-core';
import { safeAsset } from '@market/storefront-core';
import {
  defaultStorefrontAppearance,
  vendorHeroIntroduction,
} from '@market/theme/storefront';
import Button from '../ui/Button.astro';
import HarvestArtwork from './HarvestArtwork.astro';
import { storefrontText, marketText } from '@market/theme/storefront';
interface Props {
  context: StorefrontContext;
  image?: string;
  href: string;
  action: string;
  /** Market websites: the secondary button's destination (the Vendors page). */
  secondaryHref?: string;
  /**
   * Market Day mode: fixed copy that replaces the editable homepage title,
   * introduction and button labels for the day. Omit for the ordinary hero.
   */
  override?: {
    title: string;
    introduction: string;
    primaryLabel: string;
    secondaryLabel: string;
  };
}
const { context, image, href, action, secondaryHref, override } = Astro.props;
const home = (context.appearance ?? defaultStorefrontAppearance).homepage;
const media = safeAsset(home.image) ?? safeAsset(image);
const market = context.kind === 'MARKET';
const marketHeroIntroduction =
  'A little closer to the people who grow, make, and bring good things to your community. Find your next market day.';
---

<section
  class:list={['harvest-hero', market && 'harvest-hero-market']}
  data-editor-section="hero"
  aria-labelledby="home-title"
>
  <div class="harvest-hero-copy">
    {override ? (
      <>
        <h1 id="home-title">{override.title}</h1>
        <p>{override.introduction}</p>
      </>
    ) : (
      <>
        <h1 id="home-title" data-home-text="title">
          {home.title || context.name}
        </h1>
        <p
          data-home-text="introduction"
          data-fallback={market ? marketHeroIntroduction : undefined}
        >
          {home.introduction ||
            (market ? marketHeroIntroduction : vendorHeroIntroduction)}
        </p>
      </>
    )}
    {override ? (
      <div class="actions harvest-hero-actions">
        <Button href={href}>
          {override.primaryLabel} <span aria-hidden="true">&#8595;</span>
        </Button>
        {secondaryHref && (
          <Button href={secondaryHref} variant="secondary">
            {override.secondaryLabel}
          </Button>
        )}
      </div>
    ) : (
    <div class="actions harvest-hero-actions">
      <Button href={href}>
        {market ? (
          <span data-market-text="heroPrimaryLabel">
            {context.appearance?.market
              ? marketText(context.appearance, 'heroPrimaryLabel')
              : action}
          </span>
        ) : (
          <span data-storefront-text="heroPrimaryLabel">
            {storefrontText(context.appearance, 'heroPrimaryLabel')}
          </span>
        )}{' '}
        <span aria-hidden="true">&#8599;</span>
      </Button>
      {market && secondaryHref ? (
        <Button href={secondaryHref} variant="secondary">
          <span data-market-text="heroSecondaryLabel">
            {marketText(context.appearance, 'heroSecondaryLabel')}
          </span>
        </Button>
      ) : (
        context.appearance?.about.enabled && (
          <Button href="/about" variant="tertiary">
            <span data-storefront-text="heroSecondaryLabel">
              {market
                ? 'Our story'
                : storefrontText(context.appearance, 'heroSecondaryLabel')}
            </span>
          </Button>
        )
      )}
      {!market && <slot name="action" />}
    </div>
    )}
    <slot name="details" />
  </div>
  <div
    data-hero-shape={
      !market
        ? (context.appearance?.vendor?.heroShape ?? 'dome')
        : context.appearance?.market?.heroShape
    }
    class:list={['harvest-hero-visual', !media && 'harvest-hero-illustration']}
  >
    {media ? (
      <img
        class="product-media harvest-hero-image"
        src={media}
        alt=""
        width="960"
        height="1120"
        fetchpriority="high"
      />
    ) : (
      <HarvestArtwork />
    )}
    <slot name="caption" />
  </div>
</section>
