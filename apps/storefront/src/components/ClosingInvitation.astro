---
import { supportsWebsitePageHero } from '@market/theme/storefront';
import Button from './ui/Button.astro';
interface Props {
  cta: {
    heading: string;
    text: string;
    label: string;
    destination: '/products' | '/' | '/find-us' | '/contact' | '/market-dates';
  };
  section?: string;
  composition?: boolean;
}
const { cta, section = 'story-cta', composition = false } = Astro.props;
const appearance = Astro.locals.storefront?.appearance;
const managed =
  !!appearance &&
  supportsWebsitePageHero(
    appearance,
    Astro.url.pathname.replace(/^\/+|\/+$/g, ''),
    Astro.locals.storefront?.kind,
  );
---

{(!managed || composition) && (
  <section class="story-cta" data-editor-section={section}>
    <div>
      <h2 data-story-cta="heading">{cta.heading}</h2>
      {(cta.text || Astro.locals.editorPreview) && (
        <p data-story-cta="text">{cta.text}</p>
      )}
    </div>
    <Button href={cta.destination}>
      <span data-story-cta="label">{cta.label}</span>
    </Button>
  </section>
)}
