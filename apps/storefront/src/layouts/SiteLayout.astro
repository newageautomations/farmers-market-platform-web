---
import '@market/ui/styles.css';
import '@market/ui/farmstand.css';
import { seo, type StorefrontContext } from '@market/storefront-core';
import { storefrontRobotsMeta } from '@market/config';
import { themeStyle, platformTheme, fonts } from '@market/theme';
import '../styles/vendor.css';
import '../styles/market.css';
import '../styles/market-website.css';
import '../styles/checkout.css';
import { MarketCartLink } from '../components/MarketCartLink';
import {
  defaultStorefrontAppearance,
  storefrontTextSizeCss,
  storefrontThemeStyle,
  type FarmhouseSettings,
} from '@market/theme/storefront';
import '@market/theme/storefront.css';
import '../styles/homepage.css';
import HarvestHeader from '../components/home/HarvestHeader.astro';
import HarvestFooter from '../components/home/HarvestFooter.astro';
import VendorTermsLink from '../components/VendorTermsLink.astro';
import EditorBridge from '../components/EditorBridge.astro';
import PremiumHeader from '../components/modern-farmhouse/Header.astro';
import PremiumFooter from '../components/modern-farmhouse/Footer.astro';
import { farmhousePresentationStyle } from '@market/theme/farmhouse-presentation';
import farmhouseStyles from '../styles/farmhouse-v2.css?url';
import { isFarmhouse, farmhouseTextSizeCss } from '@market/theme/storefront';
import { isEditorialMarket } from '@market/theme/storefront';
import EditorialShopHeader from '../components/editorial-market/ShopHeader.astro';
import { preorderCookie, vendorPreorder } from '../lib/vendor-preorder';
import { requestMarketShop } from '../lib/shop';
import { marketDateParts } from '../lib/market-website';
import EditorialFooter from '../components/editorial-market/Footer.astro';
import editorialStyles from '../styles/editorial-market.css?url';
import FarmhouseHeader from '../components/legacy-modern-farmhouse/Header.astro';
import FarmhouseFooter from '../components/legacy-modern-farmhouse/Footer.astro';
import '../styles/legacy-modern-farmhouse.css';
import { marketOnlyTheme } from '@market/theme/storefront';
import HearthHeader from '../components/hearth/Header.astro';
import HearthFooter from '../components/hearth/Footer.astro';
import hearthStyles from '../styles/hearth.css?url';
import MeadowHeader from '../components/meadow/Header.astro';
import MeadowFooter from '../components/meadow/Footer.astro';
import meadowStyles from '../styles/meadow.css?url';
import PastureHeader from '../components/pasture/Header.astro';
import PastureFooter from '../components/pasture/Footer.astro';
import pastureStyles from '../styles/pasture.css?url';
import bloomStyles from '../styles/bloom.css?url';
import { isBloom } from '@market/theme/storefront';
interface Props {
  context?: StorefrontContext;
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  homepage?: boolean;
  imageHero?: boolean;
}
const {
  context,
  path = '/',
  title,
  description,
  noindex = false,
  homepage = false,
  imageHero = false,
} = Astro.props;
const appearance = context?.appearance ?? defaultStorefrontAppearance;
const sharedVendor = context?.kind === 'VENDOR';
// Market websites are Harvest throughout, so every market page shares its shell.
const harvestShell = homepage || sharedVendor || context?.kind === 'MARKET';
const premiumSettings = isFarmhouse(appearance)
  ? (appearance.template!.settings as FarmhouseSettings)
  : undefined;
const premium = sharedVendor && !!premiumSettings;
// Editorial Market serves vendor and market websites with one theme shell.
const editorial =
  (sharedVendor || context?.kind === 'MARKET') && isEditorialMarket(appearance);
const editorialMarket = editorial && context?.kind === 'MARKET';
const farmhouse =
  sharedVendor && appearance.theme === 'modern-farmhouse' && !premium;
// Meadow, Hearth and Pasture are market website themes with their own header, footer
// and styles around the shared Harvest market pages.
const marketTheme =
  context?.kind === 'MARKET' ? marketOnlyTheme(appearance) : undefined;
const meadow = marketTheme === 'meadow';
const hearth = marketTheme === 'hearth';
const pasture = marketTheme === 'pasture';
// Bloom is a vendor website theme: the shared Harvest vendor shell and pages with
// its own stylesheet.
const bloom = sharedVendor && isBloom(appearance);
const overlay =
  premium &&
  (imageHero ||
    (homepage &&
      premiumSettings?.sections[0]?.id === 'cinematic' &&
      premiumSettings?.sections[0]?.visible));
const appearanceStyle = context
  ? `${storefrontThemeStyle(appearance)};${premium ? farmhousePresentationStyle(appearance) : ''}${harvestShell ? '' : `;--font-heading:${fonts[context.theme.headingFont]}`}`
  : themeStyle(platformTheme);
const metadata = context ? seo(context, path) : undefined;
const pageTitle = title
  ? context
    ? `${title} | ${context.name}`
    : title
  : (metadata?.title ?? 'Storefront unavailable');
const pageDescription =
  description ?? metadata?.description ?? 'Storefront service unavailable.';
const editorialShop =
  editorial && !editorialMarket && path.startsWith('/products');
const editorialHeaderPreorder =
  editorial && !editorialShop && !editorialMarket
    ? await vendorPreorder(Astro, [])
    : undefined;
// Market headers choose a market date for the shop instead of a pickup market.
let editorialMarketDates: { id: string; marketName: string }[] = [];
if (editorialMarket && context?.source === 'backend') {
  try {
    editorialMarketDates = (
      await requestMarketShop(Astro).occurrences({
        options: { skip: 0, take: 12 },
      })
    ).marketStorefrontOccurrences.items.map((occurrence) => ({
      id: occurrence.id,
      marketName: marketDateParts(occurrence).date,
    }));
  } catch {
    /* The header remains usable without its date selector. */
  }
}
// The shop remembers a chosen market date; the header shows it on every page.
const editorialMarketChosen =
  Astro.url.searchParams.get('occurrence') ??
  Astro.cookies.get(preorderCookie(context?.storefrontId ?? ''))?.value;
const editorialMarketSelected = editorialMarketDates.some(
  (date) => date.id === editorialMarketChosen,
)
  ? editorialMarketChosen
  : undefined;
---

<!doctype html>
<html
  lang="en"
  style={appearanceStyle}
  data-storefront-theme={
    context ? (premium ? 'modern-farmhouse-v2' : appearance.theme) : undefined
  }
  data-scroll-fade={
    premium && premiumSettings?.scrollFade && !Astro.locals.editorPreview
      ? 'true'
      : undefined
  }
  data-template-version={premium ? '2' : undefined}
  data-farmhouse-palette={premium ? premiumSettings?.palette : undefined}
  data-farmhouse-type={premium ? premiumSettings?.typography : undefined}
  data-theme-palette={marketTheme || bloom ? appearance.palette : undefined}
  data-storefront-hover={bloom ? undefined : appearance.buttonHover}
  data-editor-preview={Astro.locals.editorPreview ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    {premium && <link rel="stylesheet" href={farmhouseStyles} />}
    {editorial && <link rel="stylesheet" href={editorialStyles} />}
    {meadow && <link rel="stylesheet" href={meadowStyles} />}
    {hearth && <link rel="stylesheet" href={hearthStyles} />}
    {pasture && <link rel="stylesheet" href={pastureStyles} />}
    {bloom && <link rel="stylesheet" href={bloomStyles} />}
    <style
      id="storefront-text-sizes"
      is:inline
      set:html={
        premium
          ? farmhouseTextSizeCss(appearance)
          : storefrontTextSizeCss(appearance)
      }
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={storefrontRobotsMeta(
        Astro.locals.deployment,
        noindex || !!Astro.locals.editorPreview,
        metadata?.robots,
      )}
    />
    {metadata && <link rel="canonical" href={metadata.canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {metadata && <meta property="og:url" content={metadata.canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={metadata?.favicon ?? platformTheme.favicon}
    />
    <slot name="structured-data" />
  </head>
  <body>
    {Astro.locals.editorPreview && <EditorBridge />}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {context?.source === 'fixture' && (
      <aside class="fixture-notice" aria-label="Development preview">
        Development fixture · Placeholder branding and content
      </aside>
    )}
    <div
      class:list={[
        !premium && !editorial && !marketTheme && !bloom && 'container',
        bloom && 'bloom-site',
        meadow && 'meadow-site',
        hearth && 'hearth-site',
        pasture && 'pasture-site',
        premium && 'farmhouse-site',
        premium && homepage && 'farmhouse-homepage',
        premium && (homepage || path === '/products') && 'farmhouse-refined',
        editorial && 'editorial-market-site',
        !editorial && !farmhouse && !premium && harvestShell && 'harvest-home',
        farmhouse && 'mf-site',
        context?.kind === 'MARKET' && 'market-text-links',
      ]}
    >
      {context && premium && (
        <PremiumHeader context={context} overlay={!!overlay} />
      )}
      {context && editorial && !editorialShop && (
        <EditorialShopHeader
          context={context}
          occurrences={
            editorialMarket
              ? editorialMarketDates
              : (editorialHeaderPreorder?.occurrences ?? [])
          }
          selectedId={
            editorialMarket
              ? editorialMarketSelected
              : editorialHeaderPreorder?.selected?.id
          }
        />
      )}
      {context && farmhouse && <FarmhouseHeader context={context} />}
      {context && meadow && <MeadowHeader context={context} />}
      {context && hearth && <HearthHeader context={context} />}
      {context && pasture && <PastureHeader context={context} />}
      {context &&
        !editorial &&
        !farmhouse &&
        !premium &&
        !marketTheme &&
        harvestShell && <HarvestHeader context={context} />}
      {context && !harvestShell && (
        <header class="site-header">
          <a class="brand" href="/">
            {context.theme.logo && (
              <img src={context.theme.logo} alt="" width="38" height="38" />
            )}
            {context.name}
          </a>
          <nav aria-label="Main navigation">
            {context.appearance?.about.enabled && <a href="/about">About</a>}
            <a href="/account">Account</a>
            {context.kind === 'MARKET' ? (
              <>
                <a href="/#markets">Occurrences</a>
                {context.source === 'backend' && (
                  <MarketCartLink
                    storefrontId={context.storefrontId ?? ''}
                    client:load
                  />
                )}
              </>
            ) : (
              <>
                <a href="/products">Products</a>
                <a href="/cart">Cart</a>
              </>
            )}
          </nav>
        </header>
      )}
      <main
        id="main"
        tabindex="-1"
        class:list={[editorial && !homepage && 'em-page']}
      >
        <slot />
      </main>
      {context && premium ? (
        <PremiumFooter context={context} />
      ) : context && editorial ? (
        <EditorialFooter context={context} />
      ) : context && meadow ? (
        <MeadowFooter context={context} />
      ) : context && hearth ? (
        <HearthFooter context={context} />
      ) : context && pasture ? (
        <PastureFooter context={context} />
      ) : context && farmhouse ? (
        <FarmhouseFooter context={context} />
      ) : context && harvestShell ? (
        <HarvestFooter context={context} />
      ) : (
        <footer class="site-footer">
          <p>{context?.name ?? 'Market platform'}</p>
          <VendorTermsLink context={context} />
          <p>
            {context?.source === 'fixture'
              ? 'Local development preview.'
              : 'Powered by Market platform'}
          </p>
        </footer>
      )}
    </div>
  </body>
  <script>
    import '../lib/account-form';
    import { mountFarmhouseMedia } from '../lib/farmhouse-media';
    mountFarmhouseMedia();
    import { mountFarmhouseScrollFade } from '../lib/farmhouse-scroll-fade';
    mountFarmhouseScrollFade();
    function missingImage(image: HTMLImageElement) {
      if (!image.classList.contains('product-media')) return;
      // The gallery keeps its main image mounted so another thumbnail can recover.
      if (image.hasAttribute('data-gallery-main')) return;
      if (image.classList.contains('mf-hero-image')) {
        image.hidden = true;
        return;
      }
      const fallback = document.createElement('div');
      fallback.className = 'product-media product-placeholder';
      fallback.textContent = 'Image unavailable';
      fallback.setAttribute('role', 'img');
      fallback.setAttribute(
        'aria-label',
        image.alt
          ? `${image.alt}: image unavailable`
          : 'Product image unavailable',
      );
      image.replaceWith(fallback);
    }
    document.addEventListener(
      'error',
      (event) => {
        if (event.target instanceof HTMLImageElement)
          missingImage(event.target);
      },
      true,
    );
    for (const image of document.querySelectorAll<HTMLImageElement>(
      'img.product-media',
    )) {
      if (image.complete && image.naturalWidth === 0) missingImage(image);
    }
  </script>
</html>
