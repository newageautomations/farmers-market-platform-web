---
import '@market/ui/styles.css';
import { seo, type StorefrontContext } from '@market/storefront-core';
import { themeStyle, platformTheme, fonts } from '@market/theme';
import '../styles/vendor.css';
import '../styles/market.css';
import '../styles/checkout.css';
import { MarketCartLink } from '../components/MarketCartLink';
import {
  defaultStorefrontAppearance,
  storefrontTextSizeCss,
  storefrontThemeStyle,
} from '@market/theme/storefront';
import '@market/theme/storefront.css';
import '../styles/homepage.css';
import HarvestHeader from '../components/home/HarvestHeader.astro';
import HarvestFooter from '../components/home/HarvestFooter.astro';
import EditorBridge from '../components/EditorBridge.astro';
import PremiumHeader from '../components/modern-farmhouse/Header.astro';
import PremiumFooter from '../components/modern-farmhouse/Footer.astro';
import { farmhousePresentationStyle } from '@market/theme/farmhouse-presentation';
import farmhouseStyles from '../styles/farmhouse-v2.css?url';
import { isFarmhouse, farmhouseTextSizeCss } from '@market/theme/storefront';
import FarmhouseHeader from '../components/legacy-modern-farmhouse/Header.astro';
import FarmhouseFooter from '../components/legacy-modern-farmhouse/Footer.astro';
import '../styles/legacy-modern-farmhouse.css';
interface Props {
  context?: StorefrontContext;
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  homepage?: boolean;
  imageHero?: boolean;
}
const {
  context,
  path = '/',
  title,
  description,
  noindex = false,
  homepage = false,
  imageHero = false,
} = Astro.props;
const appearance = context?.appearance ?? defaultStorefrontAppearance;
const sharedVendor = context?.kind === 'VENDOR';
const premium = sharedVendor && isFarmhouse(appearance);
const premiumSettings = appearance.template?.settings;
const farmhouse =
  sharedVendor && appearance.theme === 'modern-farmhouse' && !premium;
const overlay =
  premium &&
  (imageHero ||
    (homepage &&
      premiumSettings?.sections[0]?.id === 'cinematic' &&
      premiumSettings?.sections[0]?.visible));
const appearanceStyle = context
  ? `${storefrontThemeStyle(appearance)};${premium ? farmhousePresentationStyle(appearance) : ''}${homepage || sharedVendor ? '' : `;--font-heading:${fonts[context.theme.headingFont]}`}`
  : themeStyle(platformTheme);
const metadata = context ? seo(context, path) : undefined;
const pageTitle = title
  ? context
    ? `${title} | ${context.name}`
    : title
  : (metadata?.title ?? 'Storefront unavailable');
const pageDescription =
  description ?? metadata?.description ?? 'Storefront service unavailable.';
---

<!doctype html>
<html
  lang="en"
  style={appearanceStyle}
  data-storefront-theme={
    context ? (premium ? 'modern-farmhouse-v2' : appearance.theme) : undefined
  }
  data-scroll-fade={
    premium && premiumSettings?.scrollFade && !Astro.locals.editorPreview
      ? 'true'
      : undefined
  }
  data-template-version={premium ? '2' : undefined}
  data-farmhouse-palette={premium ? premiumSettings?.palette : undefined}
  data-farmhouse-type={premium ? premiumSettings?.typography : undefined}
  data-storefront-hover={appearance.buttonHover}
  data-editor-preview={Astro.locals.editorPreview ? 'true' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    {premium && <link rel="stylesheet" href={farmhouseStyles} />}
    <style
      id="storefront-text-sizes"
      is:inline
      set:html={
        premium
          ? farmhouseTextSizeCss(appearance)
          : storefrontTextSizeCss(appearance)
      }
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={
        noindex || Astro.locals.editorPreview
          ? 'noindex,nofollow'
          : (metadata?.robots ?? 'noindex,nofollow')
      }
    />
    {metadata && <link rel="canonical" href={metadata.canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {metadata && <meta property="og:url" content={metadata.canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={metadata?.favicon ?? platformTheme.favicon}
    />
    <slot name="structured-data" />
  </head>
  <body>
    {Astro.locals.editorPreview && <EditorBridge />}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {context?.source === 'fixture' && (
      <aside class="fixture-notice" aria-label="Development preview">
        Development fixture · Placeholder branding and content
      </aside>
    )}
    <div
      class:list={[
        !premium && 'container',
        premium && 'farmhouse-site',
        premium && homepage && 'farmhouse-homepage',
        premium && (homepage || path === '/products') && 'farmhouse-refined',
        !farmhouse && !premium && (homepage || sharedVendor) && 'harvest-home',
        farmhouse && 'mf-site',
      ]}
    >
      {context && premium && (
        <PremiumHeader context={context} overlay={!!overlay} />
      )}
      {context && farmhouse && <FarmhouseHeader context={context} />}
      {context && !farmhouse && !premium && (homepage || sharedVendor) && (
        <HarvestHeader context={context} />
      )}
      {context && !homepage && !sharedVendor && (
        <header class="site-header">
          <a class="brand" href="/">
            {context.theme.logo && (
              <img src={context.theme.logo} alt="" width="38" height="38" />
            )}
            {context.name}
          </a>
          <nav aria-label="Main navigation">
            {context.appearance?.about.enabled && <a href="/about">About</a>}
            <a href="/account">Account</a>
            {context.kind === 'MARKET' ? (
              <>
                <a href="/#occurrences">Occurrences</a>
                {context.source === 'backend' && (
                  <MarketCartLink
                    storefrontId={context.storefrontId ?? ''}
                    client:load
                  />
                )}
              </>
            ) : (
              <>
                <a href="/products">Products</a>
                <a href="/cart">Cart</a>
              </>
            )}
          </nav>
        </header>
      )}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {context && premium ? (
        <PremiumFooter context={context} />
      ) : context && farmhouse ? (
        <FarmhouseFooter context={context} />
      ) : context && (homepage || sharedVendor) ? (
        <HarvestFooter context={context} />
      ) : (
        <footer class="site-footer">
          <p>{context?.name ?? 'Market platform'}</p>
          <p>
            {context?.source === 'fixture'
              ? 'Local development preview.'
              : 'Powered by Market platform'}
          </p>
        </footer>
      )}
    </div>
  </body>
  <script>
    import '../lib/account-form';
    import { mountFarmhouseMedia } from '../lib/farmhouse-media';
    mountFarmhouseMedia();
    import { mountFarmhouseScrollFade } from '../lib/farmhouse-scroll-fade';
    mountFarmhouseScrollFade();
    function missingImage(image: HTMLImageElement) {
      if (!image.classList.contains('product-media')) return;
      // The gallery keeps its main image mounted so another thumbnail can recover.
      if (image.hasAttribute('data-gallery-main')) return;
      if (image.classList.contains('mf-hero-image')) {
        image.hidden = true;
        return;
      }
      const fallback = document.createElement('div');
      fallback.className = 'product-media product-placeholder';
      fallback.textContent = 'Image unavailable';
      fallback.setAttribute('role', 'img');
      fallback.setAttribute(
        'aria-label',
        image.alt
          ? `${image.alt}: image unavailable`
          : 'Product image unavailable',
      );
      image.replaceWith(fallback);
    }
    document.addEventListener(
      'error',
      (event) => {
        if (event.target instanceof HTMLImageElement)
          missingImage(event.target);
      },
      true,
    );
    for (const image of document.querySelectorAll<HTMLImageElement>(
      'img.product-media',
    )) {
      if (image.complete && image.naturalWidth === 0) missingImage(image);
    }
  </script>
</html>
