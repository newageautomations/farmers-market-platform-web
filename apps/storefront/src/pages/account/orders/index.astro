---
import { buttonClassName } from '@market/ui/presentation';
import CustomerLayout from '../../../layouts/CustomerLayout.astro';
import CustomerOrders from '../../../components/CustomerOrders.astro';
import {
  customerApi,
  customerSkip,
  customerAuthenticationError,
} from '../../../lib/customer-dashboard';
import { temporaryUnavailableResponse } from '@market/config';
const api = customerApi(Astro),
  skip = customerSkip(Astro.url.searchParams.get('skip'));
let purchases;
try {
  if (!(await api.profile())) return Astro.redirect(api.login);
  purchases = await api.purchases(skip);
} catch (error) {
  return customerAuthenticationError(error)
    ? Astro.redirect(api.login)
    : temporaryUnavailableResponse();
}
---

<CustomerLayout title="Order History" path="/account/orders">
  <p class="customer-muted">
    Purchases across all your markets and vendors, with each checkout shown
    once.
  </p>
  <CustomerOrders purchases={purchases.items} />
  <nav
    class="customer-pagination ui-pagination"
    aria-label="Order history pages"
  >
    <p>
      {purchases.totalItems} orders. Showing{' '}
      {purchases.items.length ? skip + 1 : 0} to{' '}
      {purchases.items.length ? skip + purchases.items.length : 0}.
    </p>
    {skip > 0 && (
      <a
        class={buttonClassName({
          variant: 'secondary',
          className: 'button secondary',
        })}
        href={`?skip=${Math.max(0, skip - 10)}`}
      >
        Previous orders
      </a>
    )}
    {skip + 10 < purchases.totalItems && (
      <a
        class={buttonClassName({
          variant: 'secondary',
          className: 'button secondary',
        })}
        href={`?skip=${skip + 10}`}
      >
        Next orders
      </a>
    )}
  </nav>
</CustomerLayout>
