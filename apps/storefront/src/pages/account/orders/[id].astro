---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PurchaseDetail from '../../../components/PurchaseDetail.astro';
import { requestCheckout } from '../../../lib/shop';
const id = Astro.params.id ?? '';
let purchase;
try {
  if (/^[1-9]\d*$/.test(id))
    purchase = await requestCheckout(Astro, Astro.response.headers).purchase(
      id,
    );
} catch {}
if (!purchase) Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<SiteLayout
  context={Astro.locals.storefront}
  path="/account/orders"
  title="Order detail"
  noindex
>
  <section class="py-12">
    <h1>Order detail</h1>
    {purchase ? (
      <PurchaseDetail purchase={purchase} />
    ) : (
      <p>This purchase is unavailable.</p>
    )}
    <p>
      <a href="/account/orders">Your orders</a>
    </p>
  </section>
</SiteLayout>
