---
import { buttonClassName } from '@market/ui/presentation';
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import WorkspacePanel from '../../components/ui/WorkspacePanel.astro';
import FarmstandIcon from '../../components/ui/FarmstandIcon.astro';
import { requestCheckout, requestPreferences } from '../../lib/shop';
import CommunicationPreferences from '../../components/ResilientSurfaces';
import { safeError } from '@market/api';
let profile, preferences, error;
try {
  profile = await requestCheckout(Astro, Astro.response.headers).profile();
  if (profile)
    preferences = await requestPreferences(
      Astro,
      Astro.response.headers,
    ).read();
} catch (e) {
  error = safeError(e);
}
if (!profile)
  return Astro.redirect('/account/login?returnTo=/account/communications');
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<CustomerLayout
  path="/account/settings"
  title="Communication preferences"
  icon="bell"
  description="Choose which messages this storefront may send you."
>
  <a
    slot="actions"
    class={buttonClassName({
      variant: 'secondary',
      className: 'farmstand-button',
    })}
    href="/account/settings"
  >
    <FarmstandIcon name="arrow-left" />
    Account settings
  </a>
  <WorkspacePanel
    icon="bell"
    title="This storefront"
    description="Saving a preference does not promise delivery. Promotions require separate explicit consent."
  >
    {preferences && Astro.locals.storefront?.storefrontId ? (
      <CommunicationPreferences
        client:load
        storefrontId={Astro.locals.storefront.storefrontId}
        initial={preferences}
      />
    ) : (
      <p class="alert ui-alert ui-alert-error" role="alert">
        {error?.kind === 'forbidden'
          ? 'These preferences are unavailable for the current account context.'
          : 'Communication settings are temporarily unavailable. Refresh to try again.'}
      </p>
    )}
  </WorkspacePanel>
</CustomerLayout>
<style is:global>
  .preference-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .preference-grid fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .preference-grid label {
    display: block;
    margin: 1rem 0;
  }
  .preference-grid button {
    margin-top: 1rem;
  }
</style>
