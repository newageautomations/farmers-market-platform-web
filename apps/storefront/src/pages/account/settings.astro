---
import { buttonClassName } from '@market/ui/presentation';
import Button from '../../components/ui/Button.astro';
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import { requestCheckout } from '../../lib/shop';
import { formatMoney, temporaryUnavailableResponse } from '@market/config';
import { safeError } from '@market/api';
import CentralAccount from '../../components/CentralAccount.astro';
import {
  accountBridge,
  accountOrigin,
  isCentral,
  type CentralAccountData,
} from '../../lib/account';
const central = isCentral(Astro.url);
let centralAccount: CentralAccountData | undefined;
if (central) {
  try {
    centralAccount = await accountBridge<CentralAccountData>({
      action: 'centralProfile',
      central: Astro.cookies.get('platform-unified-account')?.value ?? '',
    });
  } catch {
    return Astro.redirect('/account/login');
  }
}
if (centralAccount && !centralAccount.profile.phoneVerified)
  return Astro.redirect('/account/phone');
const api = central
  ? undefined
  : requestCheckout(Astro, Astro.response.headers);
let profile, purchases, accountContexts;
try {
  if (api) profile = await api.profile();
  if (profile) {
    purchases = await api!.purchases(0, 3);
    accountContexts = await api!.accountContexts();
  }
} catch (error) {
  const kind = safeError(error).kind;
  if (kind !== 'authentication' && kind !== 'forbidden')
    return temporaryUnavailableResponse();
}
if (!profile && !centralAccount) return Astro.redirect('/account/login');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<CustomerLayout path="/account/settings" title="Account Settings">
  {centralAccount ? (
    <CentralAccount account={centralAccount} embedded />
  ) : (
    profile && (
      <section class="py-12 account-panel">
        <h2 class="ui-section-title-consumer">Your account</h2>
        <p>
          {profile.firstName} {profile.lastName}
        </p>
        <p>{profile.emailAddress}</p>
        {profile.phoneNumber && <p>{profile.phoneNumber}</p>}
        <p>
          Your verified personal phone identifies your shared platform account.
        </p>
        <p>
          Current mode: Customer.{' '}
          <a
            class={buttonClassName({
              variant: 'secondary',
              className: 'button secondary',
            })}
            href={new URL('/account', accountOrigin()).toString()}
          >
            Your platform account and onboarding
          </a>
        </p>
        {accountContexts?.affiliations.length && process.env.ADMIN_ORIGIN && (
          <nav aria-label="Account modes">
            <a
              class={buttonClassName({
                variant: 'secondary',
                className: 'button secondary',
              })}
              href="/account"
              aria-current="page"
            >
              Customer
            </a>
            {accountContexts.affiliations.map((a) => (
              <a
                class={buttonClassName({
                  variant: 'secondary',
                  className: 'button secondary',
                })}
                href={`${process.env.ADMIN_ORIGIN}/${a.mode === 'VENDOR' ? 'vendor' : 'market'}?channel=${encodeURIComponent(a.channelId)}`}
              >
                {a.mode === 'VENDOR' ? 'Vendor' : 'Market Manager'}: {a.name}
              </a>
            ))}
          </nav>
        )}
        <p>
          <a
            class={buttonClassName({
              variant: 'secondary',
              className: 'button secondary',
            })}
            href="/account/communications"
          >
            Manage communication preferences
          </a>
        </p>
        <h2 class="ui-section-title-consumer">Recent purchases</h2>
        {purchases?.items.length ? (
          <ul>
            {purchases.items.map((p) => (
              <li>
                <a
                  class={buttonClassName({
                    variant: 'secondary',
                    className: 'button secondary',
                  })}
                  href={`/account/orders/${p.orderId}`}
                >
                  {p.storefront.displayName} ·{' '}
                  {new Date(p.purchasedAt).toLocaleDateString()}
                </a>{' '}
                · {formatMoney(p.financial.originalPaid, p.financial.currency)}
              </li>
            ))}
          </ul>
        ) : (
          <p>No purchases are available yet.</p>
        )}
        <p>
          <a
            class={buttonClassName({
              variant: 'secondary',
              className: 'button secondary',
            })}
            href="/account/orders"
          >
            View all orders
          </a>
        </p>
        <form method="post" action="/api/account">
          <input type="hidden" name="action" value="logout" />
          <Button type="submit" variant="primary">
            Sign out
          </Button>
        </form>
      </section>
    )
  )}
</CustomerLayout>
