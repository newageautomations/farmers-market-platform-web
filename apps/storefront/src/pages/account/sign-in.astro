---
import { isCentral, centralSignIn } from '../../lib/account';
if (!isCentral(Astro.url)) return Astro.redirect(await centralSignIn(Astro));
const next = new URL('/account/login', Astro.url);
for (const key of ['origin', 'correlation', 'destination', 'returnTo']) {
  const value = Astro.url.searchParams.get(key);
  if (value) next.searchParams.set(key, value);
}
return Astro.redirect(next.pathname + next.search);
