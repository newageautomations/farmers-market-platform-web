---
import { buttonClassName, inputClassName } from '@market/ui/presentation';
import Button from '../../components/ui/Button.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  accountBridge,
  centralSignIn,
  isCentral,
  setCentral,
  setUnifiedCentral,
} from '../../lib/account';
const central = isCentral(Astro.url),
  origin = Astro.url.searchParams.get('origin') ?? '',
  correlation = Astro.url.searchParams.get('correlation') ?? '';
let unavailable = false;
if (!central && Astro.url.searchParams.get('retry') === '1') {
  unavailable = true;
} else if (!central) {
  try {
    return Astro.redirect(await centralSignIn(Astro));
  } catch {
    unavailable = true;
  }
} else {
  try {
    if (origin) await accountBridge({ action: 'target', origin });
    const unified = Astro.cookies.get('platform-unified-account')?.value;
    if (origin && unified && /^[A-Za-z0-9_-]{43}$/.test(correlation)) {
      try {
        const result = await accountBridge<{
          central: string;
          callback: string;
        }>({
          action: 'unifiedAuthorize',
          origin,
          central: unified,
          correlation,
        });
        setUnifiedCentral(Astro, result.central);
        return Astro.redirect(result.callback);
      } catch {
        Astro.cookies.delete('platform-unified-account', { path: '/' });
      }
    }
    const cookie = Astro.cookies.get('platform-account')?.value;
    if (origin && cookie && /^[A-Za-z0-9_-]{43}$/.test(correlation)) {
      try {
        const result = await accountBridge<{
          central: string;
          callback: string;
        }>({ action: 'authorize', origin, central: cookie, correlation });
        setCentral(Astro, result.central);
        return Astro.redirect(result.callback);
      } catch {
        Astro.cookies.delete('platform-account', { path: '/' });
      }
    }
  } catch {
    unavailable = true;
  }
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const sent = Astro.url.searchParams.get('requested') === '1';
---

<SiteLayout
  context={Astro.locals.storefront}
  path="/account/sign-in"
  title="Access your orders"
  noindex
>
  <section class="py-12 account-panel">
    <h1>Access your orders</h1>
    {unavailable ? (
      <>
        <p class="alert ui-alert ui-alert-error" role="alert">
          Account access could not be completed. Please try again.
        </p>
        <a
          class={buttonClassName({ variant: 'primary', className: 'button' })}
          href="/account/sign-in"
        >
          Try account access again
        </a>
      </>
    ) : (
      <>
        <p>
          Use a one-time email link to claim your account or sign in. Your
          purchases stay on the same platform account.
        </p>
        <p>
          <a
            class={buttonClassName({
              variant: 'secondary',
              className: 'button secondary',
            })}
            href={`/account/login?origin=${encodeURIComponent(origin)}&correlation=${encodeURIComponent(correlation)}`}
          >
            Sign in with your platform password
          </a>
        </p>
        {sent && (
          <p class="alert ui-alert ui-alert-info" role="status">
            {Astro.url.searchParams.get('delivery') === 'unavailable'
              ? 'Account email delivery is currently unavailable. Your request was accepted. Please try again later.'
              : 'If that email can receive an account link, we accepted the request. Check your inbox. If delivery is unavailable, try again later.'}
          </p>
        )}
        <form method="post" action="/api/account">
          <input type="hidden" name="action" value="request" />
          {origin ? (
            <input type="hidden" name="origin" value={origin} />
          ) : (
            <label class="field">
              Storefront address
              <input
                class={inputClassName('url')}
                name="origin"
                type="url"
                required
                maxlength="2048"
                placeholder="https://your-storefront.example"
                aria-describedby="email-link-storefront"
              />
              <small id="email-link-storefront">
                Enter the address of the participating storefront where you want
                to access your orders.
              </small>
            </label>
          )}
          <input type="hidden" name="correlation" value={correlation} />
          <div class="field">
            <label for="account-email">Email</label>
            <input
              class={inputClassName('email')}
              id="account-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
          </div>
          <Button type="submit" variant="primary">
            Request account link
          </Button>
        </form>
      </>
    )}
  </section>
</SiteLayout>
