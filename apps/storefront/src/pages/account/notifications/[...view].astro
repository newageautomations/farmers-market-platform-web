---
import CustomerLayout from '../../../layouts/CustomerLayout.astro';
import CustomerNotifications from '../../../components/CustomerNotifications';
import WorkspaceMenu from '../../../components/ui/WorkspaceMenu.astro';
import {
  customerApi,
  customerAuthenticationError,
} from '../../../lib/customer-dashboard';
import { temporaryUnavailableResponse } from '@market/config';
const view = Astro.params.view ?? '';
if (!['', 'trash', 'settings', 'unsubscribed'].includes(view))
  return new Response(null, { status: 404 });
const api = customerApi(Astro);
try {
  if (!(await api.profile())) return Astro.redirect(api.login);
} catch (error) {
  return customerAuthenticationError(error)
    ? Astro.redirect(api.login)
    : temporaryUnavailableResponse();
}
const current = (view || 'inbox') as
  'inbox' | 'trash' | 'settings' | 'unsubscribed';
const titles = {
  inbox: 'Notifications',
  trash: 'Notification trash',
  settings: 'Notification settings',
  unsubscribed: 'Unsubscribed notifications',
};
---

<CustomerLayout
  title={titles[current]}
  path="/account/notifications"
  icon="bell"
  description="Order, pickup and market updates for your account, in one inbox."
>
  <WorkspaceMenu
    label="Notification views"
    current={current}
    items={[
      {
        value: 'inbox',
        label: 'Inbox',
        href: '/account/notifications',
        icon: 'inbox',
      },
      {
        value: 'trash',
        label: 'Trash',
        href: '/account/notifications/trash',
        icon: 'trash',
      },
      {
        value: 'settings',
        label: 'Settings',
        href: '/account/notifications/settings',
        icon: 'settings',
      },
      {
        value: 'unsubscribed',
        label: 'Unsubscribed',
        href: '/account/notifications/unsubscribed',
        icon: 'bell-off',
      },
    ]}
  />
  <CustomerNotifications view={current} tabs={false} client:load />
</CustomerLayout>
