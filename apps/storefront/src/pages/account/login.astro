---
import { inputClassName } from '@market/ui/presentation';
import Button from '../../components/ui/Button.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { platformName } from '@market/config';
import {
  accountBridge,
  centralSignIn,
  isCentral,
  setUnifiedCentral,
  defaultAccountDestination,
  safeAccountReturn,
  authorizeUnifiedAccount,
} from '../../lib/account';
const vendorContext =
  Astro.url.searchParams.get('context') === 'vendor' ||
  Astro.cookies.has('vendor-application-continuation');
let unavailable = false,
  identityMismatch = false;
const origin = Astro.url.searchParams.get('origin') ?? '',
  correlation = Astro.url.searchParams.get('correlation') ?? '';
if (!isCentral(Astro.url)) {
  try {
    return Astro.redirect(
      await centralSignIn(
        Astro,
        Astro.url.searchParams.get('returnTo') ?? '/account',
      ),
    );
  } catch {
    unavailable = true;
  }
} else {
  try {
    if (origin) await accountBridge({ action: 'unifiedTarget', origin });
    const cookie = Astro.cookies.get('platform-unified-account')?.value;
    const principal = Astro.url.searchParams.get('principal');
    if (cookie && principal) {
      try {
        const current = await accountBridge<
          import('../../lib/account').CentralAccountData
        >({ action: 'centralProfile', central: cookie });
        identityMismatch = current.contexts.principalId !== principal;
      } catch {
        /* Expired sessions show the credential form. */
      }
    }
    if (cookie && !identityMismatch) {
      try {
        const profile = await accountBridge<
          import('../../lib/account').CentralAccountData
        >({ action: 'centralProfile', central: cookie });
        if (!profile.profile.phoneVerified) {
          Astro.cookies.set(
            'account-login-return',
            Astro.url.searchParams.toString(),
            {
              httpOnly: true,
              secure: Astro.url.protocol === 'https:',
              sameSite: 'lax',
              path: '/',
              maxAge: 1800,
            },
          );
          return Astro.redirect('/account/phone');
        }
      } catch {
        /* The normal sign-in form handles expired authentication. */
      }
    }
    if (
      cookie &&
      !identityMismatch &&
      ['vendor', 'market'].includes(
        Astro.cookies.get('account-signup-role')?.value ?? '',
      )
    ) {
      await accountBridge({ action: 'centralProfile', central: cookie });
      const role = Astro.cookies.get('account-signup-role')!.value;
      Astro.cookies.delete('account-signup-role', { path: '/' });
      return Astro.redirect(`/account/onboarding/${role}`);
    }
    if (cookie && !identityMismatch && !origin) {
      try {
        await accountBridge({ action: 'centralProfile', central: cookie });
        return Astro.redirect(
          Astro.cookies.has('vendor-application-continuation')
            ? '/account/vendor-applications'
            : Astro.url.searchParams.has('returnTo')
              ? safeAccountReturn(Astro.url.searchParams.get('returnTo'))
              : await defaultAccountDestination(cookie),
        );
      } catch {
        Astro.cookies.delete('platform-unified-account', { path: '/' });
      }
    }
    if (
      cookie &&
      !identityMismatch &&
      /^[A-Za-z0-9_-]{43}$/.test(correlation)
    ) {
      try {
        const result = await authorizeUnifiedAccount(
          cookie,
          origin,
          correlation,
          Astro.url.searchParams.get('destination') ?? '/',
          Astro.url.searchParams.get('principal') ?? '',
        );
        setUnifiedCentral(Astro, result.central);
        return Astro.redirect(result.callback);
      } catch {
        Astro.cookies.delete('platform-unified-account', { path: '/' });
      }
    }
  } catch {
    unavailable = true;
  }
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<SiteLayout
  context={Astro.locals.storefront}
  title={`Sign in to ${platformName}`}
  noindex
>
  <section class="py-12 account-panel">
    <h1>Sign in to {platformName}</h1>
    {Astro.url.searchParams.has('verified') && (
      <p class="alert ui-alert ui-alert-info" role="status">
        Your phone is verified. Sign in to your account.
      </p>
    )}
    {Astro.url.searchParams.has('security') && (
      <p class="alert ui-alert ui-alert-info" role="status">
        Your password was updated. Sign in again.
      </p>
    )}
    {Astro.url.searchParams.has('error') && (
      <p class="alert ui-alert ui-alert-error" role="alert">
        Sign-in could not be completed. Check your email and password and try
        again. Your requested destination is retained.
      </p>
    )}
    {identityMismatch && (
      <p class="alert ui-alert ui-alert-info" role="status">
        Your central account differs from the selected workspace account. Sign
        in with the intended account to continue safely.
      </p>
    )}
    {unavailable ? (
      <p class="alert ui-alert ui-alert-error" role="alert">
        Account sign-in is temporarily unavailable. Please try again later.
      </p>
    ) : (
      <>
        <p>
          {vendorContext
            ? 'Sign in with the account that owns your Vendor business. You will continue to your Vendor application or Vendor onboarding.'
            : 'Use your existing platform credentials. Your Customer, Vendor, and Market workspaces use the same account.'}
        </p>
        <form method="post" action="/api/account">
          <input type="hidden" name="action" value="unifiedLogin" />
          <input type="hidden" name="origin" value={origin} />
          <input type="hidden" name="correlation" value={correlation} />
          <input
            type="hidden"
            name="principal"
            value={Astro.url.searchParams.get('principal') ?? ''}
          />
          <input
            type="hidden"
            name="destination"
            value={Astro.url.searchParams.get('destination') ?? '/'}
          />
          <input
            type="hidden"
            name="returnTo"
            value={Astro.url.searchParams.get('returnTo') ?? ''}
          />
          <label class="field">
            Email{' '}
            <input
              class={inputClassName('email')}
              name="email"
              type="email"
              autocomplete="username"
              required
              maxlength="254"
            />
          </label>
          <label class="field">
            Password{' '}
            <input
              class={inputClassName('password')}
              name="password"
              type="password"
              autocomplete="current-password"
              required
              maxlength="1024"
            />
          </label>
          <p>
            <a href="/account/recover">Forgot your password?</a>
          </p>
          <Button type="submit" variant="primary">
            Sign in
          </Button>
          <p class="login-signup">
            Don't have an account?{' '}
            <a
              href={
                origin && correlation
                  ? `/account/signup?origin=${encodeURIComponent(origin)}&correlation=${encodeURIComponent(correlation)}&destination=${encodeURIComponent(Astro.url.searchParams.get('destination') ?? '/')}`
                  : '/account/signup'
              }
            >
              Sign up here
            </a>
          </p>
        </form>
      </>
    )}
  </section>
</SiteLayout>
