---
import Button from '../../components/ui/Button.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isCentral } from '../../lib/account';
if (!isCentral(Astro.url)) return Astro.redirect('/account/login');
const token = Astro.url.searchParams.get('token') ?? '';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<SiteLayout title="Verify your email" noindex>
  <section class="account-panel">
    <h1>Verify your email</h1>
    <p>
      Remain signed into the account that requested this link. Email
      verification enables email recovery. Your phone has already activated your
      account.
    </p>
    <form method="post" action="/api/account">
      <input type="hidden" name="action" value="verifyEmailProof" />
      <input type="hidden" name="token" value={token} />
      <Button type="submit" variant="primary">
        Verify account email
      </Button>
    </form>
  </section>
</SiteLayout>
<script>
  history.replaceState(null, '', '/account/email-verify');
</script>
