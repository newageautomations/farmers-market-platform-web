---
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import CustomerOverview from '../../components/CustomerOverview';
import {
  customerApi,
  customerAuthenticationError,
} from '../../lib/customer-dashboard';
import { customerLoyalty } from '../../lib/loyalty';
import { temporaryUnavailableResponse } from '@market/config';
import '@market/ui/dashboard-layout.css';
const api = customerApi(Astro);
let profile, dashboard, purchases;
try {
  profile = await api.profile();
  if (!profile) return Astro.redirect(api.login);
  [dashboard, purchases] = await Promise.all([
    api.read(),
    api.purchases(0, 10),
  ]);
} catch (error) {
  return customerAuthenticationError(error)
    ? Astro.redirect(api.login)
    : temporaryUnavailableResponse();
}
// Optional sections: a failed read affects only its own section.
const [wallets, layout] = await Promise.all([
  customerLoyalty(Astro).catch(() => null),
  api.layout().catch(() => null),
]);
const timeZone =
  (profile as { timezone?: string | null }).timezone || 'America/Chicago';
---

<CustomerLayout
  title="Overview"
  name={`${profile.firstName}'s account`}
  heading={false}
>
  <CustomerOverview
    client:load
    firstName={profile.firstName}
    counts={{
      orders: dashboard.orderCount,
      markets: dashboard.marketCount,
      vendors: dashboard.vendorCount,
    }}
    events={dashboard.events}
    purchases={purchases.items}
    markets={dashboard.markets}
    vendors={dashboard.vendors}
    wallets={wallets}
    layout={layout}
    now={Date.now()}
    timeZone={timeZone}
  />
</CustomerLayout>
