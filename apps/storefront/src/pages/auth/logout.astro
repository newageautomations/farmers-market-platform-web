---
import Button from '../../components/ui/Button.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { isCentral } from '../../lib/account';
if (!isCentral(Astro.url)) return new Response('Not found', { status: 404 });
---

<SiteLayout title="Sign out" noindex>
  <section class="py-12 account-panel">
    <h1>Sign out</h1>
    <p>End your authenticated sessions across the platform.</p>
    <form method="post" action="/api/account">
      <input type="hidden" name="action" value="logout" />
      <Button type="submit" variant="primary">
        Sign out
      </Button>
    </form>
  </section>
</SiteLayout>
