---
import SiteLayout from '../../layouts/SiteLayout.astro';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<SiteLayout title="Signed out" noindex>
  <section class="py-12 account-panel">
    <h1>You are signed out</h1>
    <p>Your authenticated sessions have been signed out across the platform.</p>
    <p>
      <a href="/account/login">Sign in</a>
    </p>
  </section>
</SiteLayout>
