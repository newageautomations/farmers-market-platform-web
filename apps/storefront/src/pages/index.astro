---
import PremiumHome from '../components/modern-farmhouse/Home.astro';
import { isFarmhouse } from '@market/theme/storefront';
import { farmhouseCatalog } from '../lib/farmhouse-catalog';
import SiteLayout from '../layouts/SiteLayout.astro';
import MarketHome from '../components/MarketHome.astro';
import MarketPublicHome from '../components/MarketPublicHome.astro';
import VendorHome from '../components/VendorHome.astro';
import FarmhouseHome from '../components/legacy-modern-farmhouse/Home.astro';
import { composition } from '@market/storefront-core';
import { ErrorState } from '@market/ui';
import {
  safeError,
  type PublicCatalog,
  type PublicMarketOccurrence,
  type MarketCatalog,
} from '@market/api';
import {
  requestShop,
  requestMarketShop,
  requestPublicMarketOperations,
} from '../lib/shop';
const { storefront, storefrontError } = Astro.locals;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let catalog: PublicCatalog | undefined, catalogError;
let advertisedApplication = false;
let marketCatalog: MarketCatalog | undefined;
let occurrences: readonly PublicMarketOccurrence[] = [],
  totalOccurrences = 0;
const rawPage = Number(Astro.url.searchParams.get('occurrencePage') ?? 1);
const occurrencePage =
  Number.isSafeInteger(rawPage) && rawPage > 0 && rawPage <= 1250 ? rawPage : 1;
if (storefront?.kind === 'MARKET' && storefront.source === 'backend') {
  try {
    await requestPublicMarketOperations(Astro).application();
    advertisedApplication = true;
  } catch {
    /* Only an advertised published application grants this entry point. */
  }
  try {
    const result = await requestMarketShop(Astro).occurrences({
      options: { skip: (occurrencePage - 1) * 8, take: 8 },
    });
    occurrences = result.marketStorefrontOccurrences.items;
    totalOccurrences = result.marketStorefrontOccurrences.totalItems;
    if (occurrences[0]) {
      try {
        marketCatalog = await requestMarketShop(Astro).catalog(
          occurrences[0].id,
          { skip: 0, take: 8 },
        );
      } catch {
        /* An unavailable catalog must not hide valid market dates. */
      }
    }
  } catch (error) {
    catalogError = safeError(error);
    Astro.response.status = 503;
  }
}
if (storefront?.kind === 'VENDOR') {
  try {
    const premiumIds = [
      ...new Set(
        storefront.appearance?.template?.settings.sections.flatMap(
          (section) => section.productIds,
        ) ?? [],
      ),
    ];
    const selected = isFarmhouse(storefront.appearance)
      ? premiumIds.length
        ? premiumIds
        : null
      : storefront.appearance?.vendor?.featuredIds;
    if (selected?.length === 0) catalog = { items: [], totalItems: 0 };
    else if (isFarmhouse(storefront.appearance))
      catalog = await farmhouseCatalog(Astro);
    else if (import.meta.env.DEV && storefront.source === 'fixture') {
      const { fixtureCatalog } =
        await import('@market/storefront-core/fixtures');
      catalog = fixtureCatalog({ skip: 0, take: 3, search: '', sort: 'asc' });
    } else
      catalog = (
        await requestShop(Astro).catalog({
          options: {
            skip: 0,
            take: isFarmhouse(storefront.appearance)
              ? Math.max(12, premiumIds.length)
              : 3,
            sort: { name: 'ASC' },
            ...(selected ? { filter: { id: { in: selected } } } : {}),
          },
        })
      ).products;
    if (selected && catalog)
      catalog = {
        ...catalog,
        items: selected.flatMap((id) =>
          catalog!.items.filter((p) => p.id === id),
        ),
      };
  } catch (error) {
    catalogError = safeError(error);
  }
}
if (storefrontError)
  Astro.response.status =
    storefrontError.kind === 'not-found'
      ? 404
      : storefrontError.kind === 'forbidden'
        ? 403
        : 503;
---

<SiteLayout
  context={storefront}
  noindex={!!storefrontError || !!catalogError}
  homepage
>
  {storefront ? (
    composition(storefront) === 'market' ? (
      storefront.source === 'backend' ? (
        <MarketPublicHome
          advertisedApplication={advertisedApplication}
          context={storefront}
          occurrences={occurrences}
          catalog={marketCatalog}
          totalItems={totalOccurrences}
          page={occurrencePage}
          error={catalogError}
        />
      ) : (
        <MarketHome context={storefront} />
      )
    ) : isFarmhouse(storefront.appearance) ? (
      <PremiumHome
        context={storefront}
        catalog={catalog}
        error={catalogError}
      />
    ) : storefront.appearance?.theme === 'modern-farmhouse' ? (
      <FarmhouseHome
        context={storefront}
        catalog={catalog}
        error={catalogError}
      />
    ) : (
      <VendorHome context={storefront} catalog={catalog} error={catalogError} />
    )
  ) : (
    <div class="py-12">
      <h1>Storefront unavailable</h1>
      <ErrorState error={storefrontError} />
    </div>
  )}
</SiteLayout>
