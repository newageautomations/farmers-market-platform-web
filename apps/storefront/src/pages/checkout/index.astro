---
import { buttonClassName } from '@market/ui/presentation';
import { Checkout as PremiumCheckout } from '../../components/modern-farmhouse/Checkout';
import { isFarmhouse, marketOnlyTheme } from '@market/theme/storefront';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Checkout } from '../../components/ResilientSurfaces';
import { readCheckoutStatus } from '../../lib/checkout-status';
import { requestMarketShop, requestShop } from '../../lib/shop';
import { marketPreorder } from '../../lib/market-preorder';
import { vendorPreorder } from '../../lib/vendor-preorder';
import { VendorCheckout } from '../../components/VendorCheckout';
import '../../styles/vendor-cart.css';
import '../../styles/preorder-banner.css';
import '../../styles/vendor-checkout.css';
import { safeError } from '@market/api';
const { storefront } = Astro.locals;
const requestedPaymentOrder = Astro.url.searchParams.get('payment-order');
const paymentOrder =
  storefront?.kind === 'VENDOR' &&
  requestedPaymentOrder &&
  /^[1-9]\d*$/.test(requestedPaymentOrder)
    ? requestedPaymentOrder
    : undefined;
if (
  Astro.url.searchParams.has('payment_intent_client_secret') ||
  Astro.url.searchParams.has('payment_intent') ||
  Astro.url.searchParams.has('redirect_status')
) {
  return new Response(null, {
    status: 303,
    headers: {
      Location: paymentOrder
        ? `/checkout?payment-order=${paymentOrder}`
        : '/checkout',
      'Cache-Control': 'private, no-store',
      'Referrer-Policy': 'no-referrer',
    },
  });
}
let view, error, cart, preorder;
let images: Record<string, string> = {};
try {
  if (!Astro.locals.editorPreview) {
    const marketCart =
      storefront?.kind === 'MARKET'
        ? await requestMarketShop(Astro, Astro.response.headers)
            .bootstrap()
            .then(({ cart }) => cart)
            .catch(() => null)
        : null;
    view = await readCheckoutStatus(
      Astro,
      Astro.response.headers,
      paymentOrder ?? marketCart?.id,
    );
    if (paymentOrder && view?.committed && view.orderId === paymentOrder) {
      const headers = new Headers(Astro.response.headers);
      headers.set('Location', `/checkout/success?order=${paymentOrder}`);
      headers.set('Cache-Control', 'private, no-store');
      return new Response(null, { status: 303, headers });
    }
    if (storefront?.kind === 'MARKET') {
      preorder = await marketPreorder(Astro);
      if (marketCart && marketCart.id === view?.orderId)
        images = Object.fromEntries(
          marketCart.groups.flatMap((group) =>
            group.lines
              .filter((line) => line.featuredAsset?.preview)
              .map((line) => [line.id, line.featuredAsset!.preview]),
          ),
        );
    } else if (storefront?.kind === 'VENDOR') {
      cart = (await requestShop(Astro, Astro.response.headers).bootstrap())
        .cart;
      if (cart?.id !== view?.orderId) cart = null;
      preorder = await vendorPreorder(
        Astro,
        cart?.lines.map((line) => line.productVariant.id) ?? [],
        cart,
      );
    }
  }
} catch (e) {
  error = safeError(e);
  Astro.response.status = error.kind === 'forbidden' ? 403 : 503;
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<SiteLayout context={storefront} path="/checkout" title="Checkout" noindex>
  <section
    class={
      isFarmhouse(storefront?.appearance)
        ? 'farmhouse-checkout-route'
        : 'vendor-checkout-page'
    }
  >
    {(!preorder || !view?.groups.length) && <h1>Checkout</h1>}
    {Astro.locals.editorPreview ? (
      <p>Checkout preview is not available in the visual editor.</p>
    ) : error ? (
      <p>Checkout is temporarily unavailable. Please try again later.</p>
    ) : view && view.groups.length ? (
      storefront?.kind === 'MARKET' ? (
        <Checkout
          initial={view}
          storefrontId={storefront.storefrontId ?? ''}
          preorder={preorder}
          images={images}
          marketLayout
          concise={!!marketOnlyTheme(storefront.appearance)}
          client:load
        />
      ) : preorder && isFarmhouse(storefront?.appearance) ? (
        <PremiumCheckout
          storefrontId={storefront?.storefrontId ?? ''}
          initial={view}
          initialCart={cart ?? null}
          initialPreorder={preorder}
          client:load
        />
      ) : preorder ? (
        <VendorCheckout
          storefrontId={storefront?.storefrontId ?? ''}
          initial={view}
          initialCart={cart ?? null}
          initialPreorder={preorder}
          client:load
        />
      ) : (
        <Checkout
          initial={view}
          storefrontId={storefront?.storefrontId ?? ''}
          client:load
        />
      )
    ) : (
      <p>
        Your checkout is unavailable or your cart is empty.{' '}
        <a class={buttonClassName({ variant: 'secondary' })} href="/cart">
          Review your cart
        </a>
      </p>
    )}
  </section>
</SiteLayout>
