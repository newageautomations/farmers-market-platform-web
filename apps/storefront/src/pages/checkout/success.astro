---
import { buttonClassName } from '@market/ui/presentation';
import { Success as PremiumSuccess } from '../../components/modern-farmhouse/Success';
import { isFarmhouse } from '@market/theme/storefront';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { PurchaseSuccess } from '../../components/ResilientSurfaces';
import '../../styles/vendor-checkout.css';
import { requestCheckout } from '../../lib/shop';
const { storefront } = Astro.locals,
  order = Astro.url.searchParams.get('order');
let view;
try {
  if (!Astro.locals.editorPreview && order && /^[1-9]\d*$/.test(order))
    view = await requestCheckout(Astro, Astro.response.headers).status(order);
} catch {}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<SiteLayout
  context={storefront}
  path="/checkout/success"
  title="Order confirmation"
  noindex
>
  <section
    class={
      isFarmhouse(storefront?.appearance)
        ? 'farmhouse-success-route'
        : 'checkout-confirmation-page'
    }
  >
    {!isFarmhouse(storefront?.appearance) && <h1>Order confirmation</h1>}
    {Astro.locals.editorPreview ? (
      <p>Order confirmation preview is not available in the visual editor.</p>
    ) : isFarmhouse(storefront?.appearance) ? (
      <PremiumSuccess
        view={view ?? undefined}
        storefrontId={storefront?.storefrontId ?? ''}
        client:load
      />
    ) : view?.committed ? (
      <PurchaseSuccess
        view={view}
        storefrontId={storefront?.storefrontId ?? ''}
        client:load
      />
    ) : (
      <p>
        {view?.paymentStatus === 'FAILED'
          ? 'Payment failed. Your purchase has not been confirmed.'
          : ['PENDING', 'RECONCILIATION_REQUIRED'].includes(
                view?.paymentStatus ?? '',
              )
            ? 'Payment is still being checked. Your purchase has not been confirmed. Please do not submit another payment.'
            : 'Your purchase has not been confirmed.'}{' '}
        <a class={buttonClassName({ variant: 'secondary' })} href="/checkout">
          Check checkout status
        </a>
      </p>
    )}
  </section>
</SiteLayout>
