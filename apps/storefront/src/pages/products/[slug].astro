---
import { buttonClassName } from '@market/ui/presentation';
import PremiumInformation from '../../components/modern-farmhouse/ProductInformation.astro';
import PremiumLayout from '../../components/modern-farmhouse/ProductLayout.astro';
import PremiumGallery from '../../components/modern-farmhouse/Gallery.astro';
import PremiumCards from '../../components/modern-farmhouse/ProductCards.astro';
import EditorialProduct from '../../components/editorial-market/Product.astro';
import ShopHeader from '../../components/editorial-market/ShopHeader.astro';
import {
  isEditorialMarket,
  isFarmhouse,
  type FarmhouseSettings,
} from '@market/theme/storefront';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductLayout from '../../components/legacy-modern-farmhouse/ProductLayout.astro';
import ProductCards from '../../components/ProductCards.astro';
import VendorPreorderBanner from '../../components/VendorPreorderBanner.astro';
import { disclosureClassName } from '@market/ui/presentation';
import { readProductInformation, type PublicCatalog } from '@market/api';
import { storefrontText } from '@market/theme/storefront';
import {
  relatedProducts,
  shopCategories,
  variantProductPage,
} from '@market/storefront-core';
import '../../styles/vendor-shop.css';
import '../../styles/product-details.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Purchase as PremiumPurchase } from '../../components/modern-farmhouse/Purchase';
import { ProductPurchase } from '../../components/ProductPurchase';
import { requestShop } from '../../lib/shop';
import { vendorPreorder } from '../../lib/vendor-preorder';
import { occurrenceLabel } from '@market/storefront-core';
import { AppError, safeError, type PublicProduct } from '@market/api';
import { ErrorState } from '@market/ui';
import {
  plainDescription,
  priceLabel,
  safeAsset,
  seo,
} from '@market/storefront-core';
const { storefront, storefrontError } = Astro.locals;
const premium = isFarmhouse(storefront?.appearance);
const editorial = isEditorialMarket(storefront?.appearance);
const premiumGallery = premium
  ? (storefront!.appearance!.template!.settings as FarmhouseSettings).pages
      .gallery
  : undefined;
const Layout = premium ? PremiumLayout : ProductLayout;
const Gallery = premium ? PremiumGallery : ProductGallery;
const Cards = premium ? PremiumCards : ProductCards;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let product: PublicProduct | null = null,
  error = storefrontError,
  signedIn = false;
try {
  if (storefront?.kind === 'MARKET') throw new AppError('not-found');
  if (storefront) {
    if (import.meta.env.DEV && storefront.source === 'fixture') {
      const { fixtureProduct } =
        await import('@market/storefront-core/fixtures');
      product = fixtureProduct(Astro.params.slug ?? '');
    } else {
      const api = requestShop(Astro, Astro.response.headers);
      product = (await api.product(Astro.params.slug ?? '')).product;
      // A session outage does not erase an otherwise valid public Product.
      try {
        if (!Astro.locals.editorPreview)
          signedIn = (await api.bootstrap()).signedIn;
      } catch {
        signedIn = false;
      }
    }
    if (!product) throw new AppError('not-found');
    if (Astro.params.variantSlug) {
      product = variantProductPage(product, Astro.params.variantSlug);
      if (!product) throw new AppError('not-found');
    }
  }
} catch (e) {
  error = safeError(e);
}
if (error) Astro.response.status = error.kind === 'not-found' ? 404 : 503;
const path = product
  ? `/products/${encodeURIComponent(product.slug)}${Astro.params.variantSlug ? `/${encodeURIComponent(Astro.params.variantSlug)}` : ''}`
  : Astro.url.pathname;
let related: PublicCatalog['items'] = [];
if (
  product &&
  storefront?.source === 'backend' &&
  storefront.appearance?.vendor?.relatedEnabled !== false
) {
  try {
    const api = requestShop(Astro);
    let catalog: PublicCatalog['items'] = [];
    for (let skip = 0; ; skip += 100) {
      const { products } = await api.catalog({
        options: { skip, take: 100, sort: { id: 'ASC' } },
      });
      catalog = [...catalog, ...products.items];
      if (catalog.length >= products.totalItems) break;
      if (!products.items.length || skip >= 9900)
        throw new AppError('unavailable');
    }
    related = relatedProducts(product, catalog);
  } catch {
    /* Recommendations never erase a valid product page. */
  }
}
const info = readProductInformation(product?.productInformation);
const preorder =
  product && !error
    ? await vendorPreorder(Astro, [
        ...(product?.variants.map((v) => v.id) ?? []),
        ...related.flatMap((p) => p.variants.map((v) => v.id)),
      ])
    : {
        occurrences: [],
        selected: undefined,
        availability: [],
        unavailable: false,
      };

const structured =
  product && storefront && !error
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: product.name,
        description: plainDescription(product.description),
        url: seo(storefront, path).canonical,
        ...(safeAsset(product.featuredAsset?.preview)
          ? { image: safeAsset(product.featuredAsset?.preview) }
          : {}),
      }
    : undefined;
---

<SiteLayout
  context={storefront}
  path={path}
  title={
    error
      ? error.kind === 'not-found'
        ? 'Product not found'
        : 'Product unavailable'
      : product?.name
  }
  description={
    product ? plainDescription(product.description).slice(0, 200) : undefined
  }
  noindex={!!error}
>
  {structured && (
    <script
      slot="structured-data"
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  )}
  {editorial && storefront && (
    <ShopHeader
      context={storefront}
      occurrences={preorder.occurrences}
      selectedId={preorder.selected?.id}
    />
  )}
  <section
    class={
      premium
        ? 'farmhouse-product-route'
        : editorial
          ? 'em-product-route'
          : 'vendor-product'
    }
  >
    {error || !product ? (
      <>
        <h1>
          {error?.kind === 'not-found'
            ? 'Product not found'
            : 'Product unavailable'}
        </h1>
        <ErrorState error={error} />
        <a class={buttonClassName({ variant: 'secondary' })} href="/products">
          Browse products
        </a>
      </>
    ) : editorial && storefront ? (
      <EditorialProduct
        context={storefront}
        product={product}
        related={related}
        info={info}
        preorder={preorder}
        signedIn={signedIn}
        preview={!!Astro.locals.editorPreview}
      />
    ) : (
      <>
        <Layout theme={storefront?.appearance?.theme}>
          <VendorPreorderBanner
            slot="market"
            preorder={preorder}
            storefrontId={storefront?.storefrontId ?? ''}
            preview={!!Astro.locals.editorPreview}
          />
          <Gallery slot="gallery" product={product} layout={premiumGallery} />
          <Fragment slot="summary">
            {shopCategories([product]).length > 0 && (
              <p>
                {shopCategories([product])
                  .map((c) => c.name)
                  .join(' · ')}
              </p>
            )}
            <h1>{product.name}</h1>
            <p
              id="product-current-price"
              class="product-price"
              aria-live="polite"
            >
              {priceLabel(
                product.variants.filter(
                  (v) => v.id === Astro.url.searchParams.get('variant'),
                ).length
                  ? product.variants.filter(
                      (v) => v.id === Astro.url.searchParams.get('variant'),
                    )
                  : product.variants,
              )}
            </p>
            <p class="product-description">
              {plainDescription(product.description)}
            </p>
          </Fragment>
          {premium ? (
            <PremiumPurchase
              slot="purchase"
              priceTarget="product-current-price"
              priceFallback={priceLabel(product.variants)}
              initialVariantId={
                Astro.url.searchParams.get('variant') ?? undefined
              }
              storefrontId={storefront?.storefrontId ?? ''}
              variants={product.variants}
              signedIn={signedIn}
              fixture={storefront?.source === 'fixture'}
              occurrenceId={preorder.selected?.id}
              availability={preorder.availability}
              preview={!!Astro.locals.editorPreview}
              client:load
            />
          ) : (
            <ProductPurchase
              slot="purchase"
              priceTarget="product-current-price"
              priceFallback={priceLabel(product.variants)}
              initialVariantId={
                Astro.url.searchParams.get('variant') ?? undefined
              }
              storefrontId={storefront?.storefrontId ?? ''}
              variants={product.variants}
              signedIn={signedIn}
              fixture={storefront?.source === 'fixture'}
              occurrenceId={preorder.selected?.id}
              availability={preorder.availability}
              preview={!!Astro.locals.editorPreview}
              client:load
            />
          )}
          <Fragment slot="information">
            {premium ? (
              <PremiumInformation info={info} preorder={preorder} />
            ) : (
              <div
                class="product-information"
                data-editor-section="information"
                aria-label="Product information"
              >
                {(
                  [
                    ['Ingredients', info.ingredients],
                    ['Allergens', info.allergens],
                    ['Storage & Care', info.storage],
                  ] as const
                ).map(
                  ([title, entry]) =>
                    entry.enabled &&
                    entry.content.trim() && (
                      <details class={disclosureClassName()}>
                        <summary>{title}</summary>
                        <div class="ui-disclosure-content product-information-text">
                          {entry.content}
                        </div>
                      </details>
                    ),
                )}
                {info.pickupEnabled &&
                  (preorder.selected ||
                    (info.pickup.enabled && info.pickup.content.trim())) && (
                    <details class={disclosureClassName()}>
                      <summary>Pickup Information</summary>
                      <div class="ui-disclosure-content">
                        {preorder.selected && (
                          <>
                            <p>
                              {preorder.selected.marketName} ·{' '}
                              {occurrenceLabel(preorder.selected)}
                            </p>
                            {preorder.selected.venue && (
                              <p>{preorder.selected.venue}</p>
                            )}
                          </>
                        )}
                        {preorder.selected?.pickupInstructions && (
                          <p class="product-information-text">
                            {preorder.selected.pickupInstructions}
                          </p>
                        )}
                        {info.pickup.enabled && (
                          <p class="product-information-text">
                            {info.pickup.content}
                          </p>
                        )}
                      </div>
                    </details>
                  )}
                {info.custom
                  .filter(
                    (v) => v.enabled && v.title.trim() && v.content.trim(),
                  )
                  .map((entry) => (
                    <details class={disclosureClassName()}>
                      <summary>{entry.title}</summary>
                      <div class="ui-disclosure-content product-information-text">
                        {entry.content}
                      </div>
                    </details>
                  ))}
              </div>
            )}
          </Fragment>
        </Layout>
        {related.length > 0 &&
          storefront?.appearance?.vendor?.relatedEnabled !== false && (
            <section
              class:list={['product-related', premium && 'farmhouse-refined']}
              data-editor-section="related"
            >
              <h2 data-storefront-text="relatedHeading">
                {storefrontText(storefront?.appearance, 'relatedHeading')}
              </h2>
              <Cards
                theme={storefront?.appearance?.theme}
                items={related}
                featured={premium}
                storefrontId={storefront?.storefrontId}
                shop
                occurrenceId={preorder.selected?.id}
                availability={preorder.availability}
                preview={!!Astro.locals.editorPreview}
              />
            </section>
          )}
      </>
    )}
  </section>
</SiteLayout>
