---
import HarvestShop from '../../components/home/HarvestShop.astro';
import WebsitePageRegion from '../../components/WebsitePageRegion.astro';
import TaxonomyFilters from '../../components/TaxonomyFilters.astro';
import { vendorTaxonomy } from '../../lib/storefront-taxonomy';
import {
  availableTaxonomy,
  taxonomyFilters,
  taxonomyNavigation,
} from '@market/storefront-core';
import PremiumShop from '../../components/modern-farmhouse/Shop.astro';
import EditorialShop from '../../components/editorial-market/Shop.astro';
import { isEditorialMarket, isFarmhouse } from '@market/theme/storefront';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { requestShop } from '../../lib/shop';
import { vendorPreorder } from '../../lib/vendor-preorder';
import { AppError, safeError, type PublicCatalog } from '@market/api';
import {
  catalogInputs,
  shopProducts,
  productPreorder,
  SHOP_PAGE_SIZE,
} from '@market/storefront-core';
import '../../styles/vendor-shop.css';
const { storefront, storefrontError } = Astro.locals;
if (storefront?.kind === 'MARKET')
  return Astro.redirect('/shop' + Astro.url.search, 302);
Astro.response.headers.set('Cache-Control', 'private, no-store');
let error = storefrontError,
  items: PublicCatalog['items'] = [],
  page = 1;
let taxonomy: Awaited<ReturnType<typeof vendorTaxonomy>> | undefined;
let matchingIds: Set<string> | undefined;
let preorder: Awaited<ReturnType<typeof vendorPreorder>> = {
  occurrences: [],
  selected: undefined,
  availability: [],
  unavailable: false,
  orderOccurrence: undefined,
};
const category = Astro.url.searchParams.get('category') ?? '',
  sort = Astro.url.searchParams.get('sort') === 'name' ? 'name' : 'default',
  search = (Astro.url.searchParams.get('search') ?? '').slice(0, 100),
  availabilityFilter =
    isEditorialMarket(storefront?.appearance) &&
    Astro.url.searchParams.get('availability') !== 'all'
      ? 'available'
      : 'all';
try {
  page = catalogInputs(Astro.url.searchParams).page;
  if (storefront?.source === 'backend') {
    const filters = taxonomyFilters(Astro.url.searchParams);
    taxonomy = await vendorTaxonomy(Astro);
    const filteredProjection =
      filters.categoryIds.length || filters.tagIds.length
        ? await requestShop(Astro).taxonomy(filters)
        : taxonomy;
    matchingIds = new Set(filteredProjection.products.map((p) => p.productId));
  }
  if (storefront?.source === 'fixture' && import.meta.env.DEV) {
    const { fixtureCatalog } = await import('@market/storefront-core/fixtures');
    items = fixtureCatalog({
      search: '',
      sort: 'asc',
      skip: 0,
      take: 100,
    }).items;
  } else if (storefront) {
    const api = requestShop(Astro);
    for (let skip = 0; matchingIds?.size !== 0; skip += 100) {
      const { products } = await api.catalog({
        options: {
          skip,
          take: 100,
          sort: { id: 'ASC' },
          ...(matchingIds
            ? {
                filter: {
                  id: { in: [...matchingIds] },
                  ...(search ? { name: { contains: search } } : {}),
                },
              }
            : {}),
        },
      });
      items = [...items, ...products.items];
      if (items.length >= products.totalItems) break;
      if (!products.items.length || skip >= 9900)
        throw new AppError('unavailable');
    }
  }
} catch (e) {
  error = safeError(e);
}
if (matchingIds) items = items.filter((p) => matchingIds!.has(p.id));
let filtered = shopProducts(items, '', sort).filter(
  (product) =>
    (!isFarmhouse(storefront?.appearance) &&
      !isEditorialMarket(storefront?.appearance)) ||
    !search ||
    product.name.toLocaleLowerCase().includes(search.toLocaleLowerCase()),
);
if (
  !error &&
  isEditorialMarket(storefront?.appearance) &&
  availabilityFilter === 'available'
) {
  preorder = await vendorPreorder(
    Astro,
    taxonomy
      ? taxonomy.products.flatMap((product) => product.variantIds.map(String))
      : filtered.flatMap((product) =>
          product.variants.map((variant) => variant.id),
        ),
  );
  filtered = filtered.filter(
    (product) =>
      productPreorder(product.variants, preorder.availability).available,
  );
  if (taxonomy) {
    const availableVariants = new Set(
      preorder.availability.filter((v) => v.available).map((v) => v.variantId),
    );
    const availableProducts = new Set(
      taxonomy.products
        .filter((p) =>
          p.variantIds.some((id) => availableVariants.has(String(id))),
        )
        .map((p) => p.productId),
    );
    taxonomy = {
      ...taxonomy,
      taxonomy: availableTaxonomy(
        taxonomy.taxonomy,
        taxonomy.products,
        availableProducts,
      ),
    };
  }
}
const categories = taxonomy
  ? taxonomyNavigation(
      taxonomy.taxonomy,
      storefront?.appearance?.categoryPresentation,
    )
  : [];
const skip = (page - 1) * SHOP_PAGE_SIZE;
const visible = filtered.slice(skip, skip + SHOP_PAGE_SIZE);
if (
  !error &&
  !(
    isEditorialMarket(storefront?.appearance) &&
    availabilityFilter === 'available'
  )
)
  preorder = await vendorPreorder(
    Astro,
    visible.flatMap((p) => p.variants.map((v) => v.id)),
  );
const selected = preorder.selected;
const link = (next: {
  category?: string;
  page?: number;
  availability?: string;
}) => {
  const query = new URLSearchParams(Astro.url.searchParams);
  query.set('sort', sort);
  if (selected) query.set('occurrence', selected.id);
  if (next.category !== undefined) {
    query.delete('category');
    if (next.category) query.set('category', next.category);
  }
  if (next.availability !== undefined)
    query.set('availability', next.availability);
  if (next.page) query.set('page', String(next.page));
  else query.delete('page');
  return '/products?' + query;
};
if (error)
  Astro.response.status =
    error.kind === 'not-found' ? 404 : error.kind === 'validation' ? 400 : 503;
---

<SiteLayout
  context={storefront}
  path="/products"
  title="Shop"
  imageHero={!error && isFarmhouse(storefront?.appearance)}
  noindex={!!error || !items.length}
>
  {storefront?.kind === 'VENDOR' &&
    (error ||
      (!isFarmhouse(storefront.appearance) &&
        !isEditorialMarket(storefront.appearance))) && (
      <WebsitePageRegion context={storefront} page="products" region="before" />
    )}
  {storefront && isFarmhouse(storefront.appearance) && !error ? (
    <PremiumShop
      context={storefront}
      categories={categories}
      category={category}
      sort={sort}
      page={page}
      visible={visible}
      total={filtered.length}
      preorder={preorder}
      link={link}
      preview={!!Astro.locals.editorPreview}
    >
      <WebsitePageRegion
        slot="editorial"
        context={storefront}
        page="products"
        region="before"
      />
      {taxonomy && (
        <TaxonomyFilters
          taxonomy={taxonomy.taxonomy}
          settings={storefront.appearance?.categoryPresentation}
          query={Astro.url.searchParams}
        />
      )}
    </PremiumShop>
  ) : storefront && isEditorialMarket(storefront.appearance) && !error ? (
    <EditorialShop
      context={storefront}
      categories={categories}
      category={category}
      search={search}
      sort={sort}
      availabilityFilter={availabilityFilter}
      page={page}
      visible={visible}
      total={filtered.length}
      skip={skip}
      occurrences={preorder.occurrences}
      selectedId={selected?.id}
      storefrontId={storefront.storefrontId}
      availability={preorder.availability}
      unavailable={preorder.unavailable}
      preview={!!Astro.locals.editorPreview}
      link={link}
    >
      <WebsitePageRegion
        slot="editorial"
        context={storefront}
        page="products"
        region="before"
      />
      {taxonomy && (
        <TaxonomyFilters
          taxonomy={taxonomy.taxonomy}
          settings={storefront.appearance?.categoryPresentation}
          query={Astro.url.searchParams}
        />
      )}
    </EditorialShop>
  ) : (
    <HarvestShop
      context={storefront}
      error={error}
      items={items}
      visible={visible}
      total={filtered.length}
      page={page}
      sort={sort}
      category={category}
      search={search}
      categories={categories}
      taxonomy={taxonomy?.taxonomy}
      query={Astro.url.searchParams}
      preorder={preorder}
      link={link}
      preview={!!Astro.locals.editorPreview}
    />
  )}
</SiteLayout>
