---
import {
  AppError,
  safeError,
  type MarketCatalog,
  type MarketOccurrenceVendor,
} from '@market/api';
import {
  marketCatalogInputs,
  taxonomyNavigation,
} from '@market/storefront-core';
import WebsitePageRegion from '../../components/WebsitePageRegion.astro';
import HarvestShop from '../../components/home/HarvestShop.astro';
import EditorialShopHero from '../../components/editorial-market/ShopHero.astro';
import { isEditorialMarket } from '@market/theme/storefront';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { requestMarketShop } from '../../lib/shop';
import { marketPreorder } from '../../lib/market-preorder';
import {
  marketProduct,
  marketCatalogAvailability,
  marketProductLink,
  marketShopQuery,
  marketShopCatalog,
} from '../../lib/market-catalog';
import type { VendorPreorderState } from '../../lib/vendor-preorder';

const { storefront, storefrontError } = Astro.locals;
if (storefront?.kind === 'VENDOR')
  return Astro.redirect('/products' + Astro.url.search, 302);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const resultsOnly = Astro.request.headers.get('x-market-shop-results') === '1';
let error = storefrontError;
let preorder: VendorPreorderState = {
  occurrences: [],
  selected: undefined,
  availability: [],
  unavailable: false,
  orderOccurrence: undefined,
};
let catalog: MarketCatalog | undefined;
let taxonomy: MarketCatalog['taxonomy'] | undefined;
let vendors: MarketOccurrenceVendor[] = [];
const query = marketShopQuery(Astro.url.searchParams);
// Accept links using the vendor Harvest sort values as well.
if (query.get('sort') === 'name' || query.get('sort') === 'default')
  query.set('sort', 'NAME_ASC');
let { page, options } = marketCatalogInputs(new URLSearchParams());
try {
  ({ page, options } = marketCatalogInputs(query));
  query.set('sort', options.sort ?? 'NAME_ASC');
  if (storefront?.kind !== 'MARKET') throw new AppError('not-found');
  preorder = await marketPreorder(Astro);
  if (preorder.selected) {
    const occurrence = preorder.selected.id;
    query.set('occurrence', occurrence);
    const api = requestMarketShop(Astro);
    const [results, directory, categoryOptions] = await Promise.all([
      marketShopCatalog((next) => api.catalog(occurrence, next), options),
      resultsOnly ? [] : api.vendors(occurrence),
      !resultsOnly && options.vendorIds?.length
        ? api.catalog(occurrence, {
            ...options,
            vendorIds: [],
            skip: 0,
            take: 1,
          })
        : undefined,
    ]);
    catalog = results;
    vendors = directory;
    taxonomy = (categoryOptions ?? catalog).taxonomy;
    preorder.availability = marketCatalogAvailability(catalog.items);
  }
} catch (value) {
  error = safeError(value);
}
if (error)
  Astro.response.status = ['not-found', 'forbidden'].includes(error.kind)
    ? 404
    : error.kind === 'validation'
      ? 400
      : 503;
const items = catalog?.items.map(marketProduct) ?? [];
const category = query.get('category') ?? '';
const categories = taxonomy
  ? taxonomyNavigation(taxonomy, storefront?.appearance?.categoryPresentation)
  : [];
const sellerNames = Object.fromEntries(
  catalog?.items.map((item) => [item.productId, item.vendorName]) ?? [],
);
const productLinks = Object.fromEntries(
  catalog?.items.map((item) => [
    item.productId,
    marketProductLink(item.variantId, preorder.selected?.id),
  ]) ?? [],
);
const link = (next: { category?: string; page?: number }) => {
  const params = new URLSearchParams(query);
  if (next.category !== undefined) {
    params.delete('category');
    if (next.category) params.set('category', next.category);
  }
  params.delete('page');
  if (next.page && next.page > 1) params.set('page', String(next.page));
  return `/shop?${params}`;
};
// Editorial Market keeps its shop artwork above the shared market catalog.
const appearance = storefront?.appearance;
const editorial = isEditorialMarket(appearance)
  ? appearance.template.settings
  : undefined;
const ShopLayout = resultsOnly ? Fragment : SiteLayout;
const ShopWrapper = editorial && !resultsOnly ? 'div' : Fragment;
const wrapperProps =
  editorial && !resultsOnly
    ? {
        class: 'em-shop em-market-shop',
        'data-template': 'editorial-market-shop',
      }
    : {};
---

<ShopLayout context={storefront} path="/shop" title="Shop" noindex={!!error}>
  <ShopWrapper {...wrapperProps}>
    {!resultsOnly && editorial && <EditorialShopHero settings={editorial} />}
    {!resultsOnly && (
      <WebsitePageRegion context={storefront} page="products" region="before" />
    )}
    <HarvestShop
      context={storefront}
      error={error}
      market
      resultsOnly={resultsOnly}
      editorialChrome={!!editorial}
      items={items}
      visible={items}
      total={catalog?.totalItems ?? 0}
      page={page}
      sort={options.sort ?? 'NAME_ASC'}
      category={category}
      search={options.search ?? ''}
      categories={categories}
      marketVendors={vendors}
      query={query}
      preorder={preorder}
      link={link}
      sellerNames={sellerNames}
      productLinks={productLinks}
      preview={!!Astro.locals.editorPreview}
      sortOptions={[
        { value: 'NAME_ASC', label: 'Name A to Z' },
        { value: 'NAME_DESC', label: 'Name Z to A' },
        { value: 'PRICE_ASC', label: 'Price low to high' },
        { value: 'PRICE_DESC', label: 'Price high to low' },
      ]}
    />
  </ShopWrapper>
</ShopLayout>
