---
import {
  supportsWebsitePageHero,
  themePageStructure,
} from '@market/theme/storefront';
import WebsitePageRegion from '../components/WebsitePageRegion.astro';
import PremiumContent from '../components/modern-farmhouse/Content.astro';
import EditorialContent from '../components/editorial-market/Content.astro';
import { isEditorialMarket, isFarmhouse } from '@market/theme/storefront';
import SiteLayout from '../layouts/SiteLayout.astro';
import PolicyListPage from '../components/PolicyListPage.astro';
import {
  defaultMarketPolicies,
  defaultPolicies,
} from '@market/theme/storefront';
const { storefront, editorPreview } = Astro.locals;
const config =
  storefront?.appearance?.policies ??
  (editorPreview
    ? storefront?.kind === 'MARKET' &&
      themePageStructure(storefront.appearance?.theme).marketStarterText
      ? defaultMarketPolicies
      : defaultPolicies
    : undefined);
const enabled = !!storefront && !!config && (config.enabled || !!editorPreview);
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (!enabled) Astro.response.status = storefront ? 404 : 503;
const sectionHero =
  !!storefront?.appearance &&
  supportsWebsitePageHero(storefront.appearance, 'policies');
---

<SiteLayout
  context={storefront}
  path="/policies"
  title={enabled ? config!.title : 'Page unavailable'}
  noindex={!enabled}
>
  {enabled && (
    <WebsitePageRegion context={storefront} page="policies" region="before" />
  )}
  {enabled && storefront && isFarmhouse(storefront.appearance) ? (
    <PremiumContent
      context={storefront}
      hideHero={sectionHero}
      page="policies"
      preview={!!Astro.locals.editorPreview}
    />
  ) : enabled && storefront && isEditorialMarket(storefront.appearance) ? (
    <EditorialContent
      context={storefront}
      hideHero={sectionHero}
      page="policies"
      preview={!!Astro.locals.editorPreview}
    />
  ) : enabled && config ? (
    <PolicyListPage
      config={config}
      sectionHero={sectionHero}
      closing={
        !(
          themePageStructure(storefront?.appearance?.theme)
            .noClosingPages as readonly string[]
        ).includes('policies')
      }
      emptyMessage="Add a complete, visible policy to preview it here."
    />
  ) : (
    <section>
      <h1>Page unavailable</h1>
      <p>This Policies page is not available.</p>
    </section>
  )}
  {enabled && (
    <WebsitePageRegion context={storefront} page="policies" region="after" />
  )}
</SiteLayout>
