---
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import CustomerNotifications from '../../components/CustomerNotifications';
import {
  customerApi,
  customerAuthenticationError,
} from '../../lib/customer-dashboard';
import { temporaryUnavailableResponse } from '@market/config';
const view = Astro.params.view ?? '';
if (!['', 'settings', 'unsubscribed'].includes(view))
  return new Response(null, { status: 404 });
const api = customerApi(Astro);
try {
  if (!(await api.profile())) return Astro.redirect(api.login);
} catch (error) {
  return customerAuthenticationError(error)
    ? Astro.redirect(api.login)
    : temporaryUnavailableResponse();
}
const title =
  view === 'settings'
    ? 'Notification settings'
    : view === 'unsubscribed'
      ? 'Unsubscribed notifications'
      : 'Notifications';
---

<CustomerLayout title={title} path="/notifications">
  <CustomerNotifications
    view={
      view === 'settings'
        ? 'settings'
        : view === 'unsubscribed'
          ? 'unsubscribed'
          : 'inbox'
    }
    client:load
  />
</CustomerLayout>
