---
// Former unscoped customer inbox routes now live with the rest of the
// customer dashboard under /account.
const view = Astro.params.view ?? '';
if (!['', 'settings', 'unsubscribed'].includes(view))
  return new Response(null, { status: 404 });
return Astro.redirect(
  `/account/notifications${view ? `/${view}` : ''}${Astro.url.search}`,
  301,
);
