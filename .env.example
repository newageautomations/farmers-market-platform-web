# Server/build configuration. Copy to .env at the repository root.
APP_ENV=dev
SHOP_API_URL=http://localhost:3000/shop-api
PUBLIC_ADMIN_API_URL=http://localhost:3000/admin-api
# Only the local fixture command may enable this. Builds reject true.
FRONTEND_FIXTURE_MODE=false
# Schema refresh reads source only. It never bootstraps the backend.
BACKEND_REFERENCE_PATH=E:/coding/farmers-market-platform
# Same server-side account configuration in backend and Storefront.
PLATFORM_ACCOUNT_ORIGIN=http://auth.platform.localhost:4321
# Supply a random secret of at least 32 characters; never expose it publicly.
PLATFORM_ACCOUNT_BRIDGE_KEY=
# Production requires APP_ENV=production and NODE_ENV=production, HTTPS API/account/Admin URLs,
# a strong random bridge key, and explicit native HTTPS listener certificate paths.
# Synthetic placeholders only, never deploy these domains.
# ADMIN_ORIGIN=https://admin.platform.example.invalid
# SHOP_API_URL=https://api.platform.example.invalid/shop-api
# PUBLIC_ADMIN_API_URL=https://api.platform.example.invalid/admin-api
# PLATFORM_ACCOUNT_ORIGIN=https://auth.platform.example.invalid
# TRUSTED_PROXY_CIDRS=disabled
